# Security headers for every response (Cloudflare Workers static assets).
# The Content-Security-Policy for scripts/styles is emitted per page by Astro
# (security.csp in astro.config.mjs); frame-ancestors only works as a header.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# Hashed build assets never change
/assets/*
  Cache-Control: public, max-age=31536000, immutable
