---
import Img from './shared/Img.astro';
const CLIENTS = [
  { name: 'PowerGrid', src: '/images/clients/powergrid.png' },
  { name: 'SpaGe', src: '/images/clients/spage.png' },
  { name: 'KEC', src: '/images/clients/kec.png' },
  { name: 'L&T Construction', src: '/images/clients/lt.png' },
  { name: 'Kalpataru', src: '/images/clients/kalpataru.png' },
  { name: 'Skipper Limited', src: '/images/clients/skipper.png' },
  { name: 'Bajel', src: '/images/clients/bajel.png' },
];
---

<!-- Logos glide continuously (pure CSS). The list is rendered four times so that half
     the track is wider than any screen and the loop is seamless; the extra copies
     are hidden from screen readers. Hovering or focusing
     pauses it, and reduced-motion visitors get a static, wrapping row. -->
<div class="client-marquee relative flex h-[120px] w-full items-center overflow-hidden border-b border-gray-200 bg-white" role="region" aria-label="Our clients">
  <div class="marquee-track flex w-max items-center">
    {[0, 1, 2, 3].map((copy) => (
      <ul class="flex shrink-0 items-center gap-12 pr-12 md:gap-20 md:pr-20" aria-hidden={copy > 0 ? 'true' : undefined}>
        {CLIENTS.map((client) => (
          <li class="flex h-16 w-32 shrink-0 items-center justify-center">
            <Img sizes="128px"
              src={client.src}
              alt={copy > 0 ? '' : client.name}
              class="max-h-full max-w-full object-contain grayscale transition-all duration-300 hover:grayscale-0"
            />
          </li>
        ))}
      </ul>
    ))}
  </div>

  <!-- Soft fade at both edges -->
  <div class="pointer-events-none absolute inset-y-0 left-0 w-16 bg-gradient-to-r from-white to-transparent md:w-32"></div>
  <div class="pointer-events-none absolute inset-y-0 right-0 w-16 bg-gradient-to-l from-white to-transparent md:right-[4.5rem] md:w-32"></div>

  <!-- Pause control: moving content needs a keyboard-reachable way to stop it (WCAG 2.2.2) -->
  <button
    type="button"
    data-marquee-toggle
    aria-pressed="false"
    class="marquee-toggle absolute bottom-2 left-2 z-20 flex h-8 w-8 items-center justify-center rounded-full bg-white/90 text-gray-500 shadow-sm ring-1 ring-gray-200 transition-colors hover:text-brand-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-blue"
    aria-label="Pause client logos"
  >
    <svg data-icon-pause width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><rect x="2" y="1" width="3" height="10" rx="1"/><rect x="7" y="1" width="3" height="10" rx="1"/></svg>
    <svg data-icon-play class="hidden" width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M3 1.5v9l7-4.5z"/></svg>
  </button>

  <!-- Yellow Diagonal Stripes on the extreme right -->
  <div
    class="hidden lg:block absolute right-0 top-0 h-full w-[4.5rem] z-30"
    style="background: repeating-linear-gradient(-55deg, #FFC62F 0px, #FFC62F 18px, #FFFFFF 18px, #FFFFFF 28px)"
  ></div>
</div>

<style>
  .marquee-track {
    animation: marquee 60s linear infinite;
  }
  .client-marquee:hover .marquee-track,
  .client-marquee:focus-within .marquee-track,
  .client-marquee[data-paused] .marquee-track {
    animation-play-state: paused;
  }
  /* Copies are identical (logos plus trailing gap), so -50% lands exactly where copy 3 starts */
  @keyframes marquee {
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      width: 100%;
      justify-content: center;
    }
    .marquee-track > ul {
      flex-wrap: wrap;
      justify-content: center;
      row-gap: 0;
    }
    .marquee-track > ul[aria-hidden],
    .marquee-toggle {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-marquee-toggle]').forEach((button) => {
    const root = button.closest<HTMLElement>('.client-marquee')!;
    button.addEventListener('click', () => {
      const paused = root.toggleAttribute('data-paused');
      button.setAttribute('aria-pressed', String(paused));
      button.querySelector('[data-icon-pause]')!.classList.toggle('hidden', paused);
      button.querySelector('[data-icon-play]')!.classList.toggle('hidden', !paused);
    });
  });
</script>
