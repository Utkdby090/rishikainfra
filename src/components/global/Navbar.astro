---
import { SITE_CONFIG } from '../../data/siteConfig';
---

<header class="sticky top-0 z-50 w-full border-b border-cyber-border/80 bg-cyber-dark/80 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3">
      <div class="w-10 h-10 rounded bg-brand-500 flex items-center justify-center font-bold text-xl text-white tracking-tighter">
        ri
      </div>
      <div>
        <span class="text-lg font-bold tracking-wider text-white uppercase block leading-none">Rishika</span>
        <span class="text-xs font-mono tracking-widest text-brand-accent leading-none">INFRA</span>
      </div>
    </a>

    <!-- Navigation Links -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
      <a href="#services" class="hover:text-brand-accent transition-colors">Services</a>
      <a href="#inspection-tech" class="hover:text-brand-accent transition-colors">Technology</a>
      <a href="#clients" class="hover:text-brand-accent transition-colors">Clients</a>
      <a href="#contact" class="hover:text-brand-accent transition-colors">Contact</a>
    </nav>

    <!-- Request Quote Action -->
    <div class="flex items-center gap-4">
      <a 
        href="tel:+919811331744" 
        class="hidden lg:block text-xs font-mono text-slate-400 hover:text-white"
      >
        +91 9811331744
      </a>
      <a
        href="#contact"
        class="inline-flex items-center justify-center px-4 py-2 rounded text-xs font-semibold uppercase tracking-wider bg-brand-500 hover:bg-brand-600 text-white transition-all shadow-[0_0_20px_rgba(0,112,186,0.3)]"
      >
        Request RFQ
      </a>
    </div>
  </div>
</header>