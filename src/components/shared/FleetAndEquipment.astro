---
// Reusable Technology Fleet & Equipment Component
---

<section class="bg-[#17212B] py-24 overflow-hidden border-t border-white/10">
  <div class="mx-auto max-w-[1440px] px-6 lg:px-16">
    
    <!-- Header -->
    <div class="scroll-animate mb-16 text-center md:text-left opacity-0 translate-y-8 transition-all duration-1000 ease-out">
      <p class="text-sm font-bold uppercase tracking-[0.25em] text-[#FFC62F] mb-2">
        HARDWARE & SOFTWARE CAPABILITIES
      </p>
      <h2 class="text-4xl font-bold text-white md:text-5xl">
        Our Technology Fleet
      </h2>
      <p class="mt-5 text-lg text-white/70 max-w-2xl">
        Our inspection services are supported by industry-leading, enterprise-grade drone technology and sensor payloads to ensure sub-centimeter accuracy.
      </p>
    </div>

    <!-- 3-Column Fleet Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10 items-start">
      
      <!-- Card 1: Drone Platforms -->
      <div class="scroll-animate opacity-0 translate-x-[-20px] transition-all duration-1000 ease-out" style="transition-delay: 150ms;">
        {/* Uniform Image Sizing Container */}
        <div class="relative h-[300px] xl:h-[350px] w-full rounded-2xl overflow-hidden mb-8 shadow-2xl border border-white/10 group">
          <img 
            src="images/technologyFleet/drone.jpg" 
            alt="Enterprise Industrial Drone" 
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-1000 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#101820] to-transparent opacity-80"></div>
          <div class="absolute bottom-0 left-0 p-6 xl:p-8">
            <div class="flex items-center gap-3 mb-2">
              <div class="w-10 h-10 rounded-full bg-[#FFC62F] flex items-center justify-center text-[#17212B] font-bold shadow-lg">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              </div>
              <h3 class="text-xl xl:text-2xl font-bold text-white">Drone Platforms</h3>
            </div>
          </div>
        </div>
        
        <ul class="space-y-5 px-2">
          <li class="flex items-start gap-4 group">
            <span class="text-[#FFC62F] mt-1 text-lg group-hover:scale-125 transition-transform">✓</span>
            <div>
              <h4 class="text-white font-bold text-lg">Type-Certified SURVEYXK</h4>
              <p class="text-white/60 text-sm mt-1 leading-relaxed">DGCA approved platforms for reliable, compliant industrial operations.</p>
            </div>
          </li>
          <li class="flex items-start gap-4 group">
            <span class="text-[#FFC62F] mt-1 text-lg group-hover:scale-125 transition-transform">✓</span>
            <div>
              <h4 class="text-white font-bold text-lg">RTK-Enabled Sub-Centimeter Drones</h4>
              <p class="text-white/60 text-sm mt-1 leading-relaxed">Real-Time Kinematic positioning for absolute precision in geospatial mapping.</p>
            </div>
          </li>
          <li class="flex items-start gap-4 group">
            <span class="text-[#FFC62F] mt-1 text-lg group-hover:scale-125 transition-transform">✓</span>
            <div>
              <h4 class="text-white font-bold text-lg">PPK-Enabled Systems</h4>
              <p class="text-white/60 text-sm mt-1 leading-relaxed">Post-Processed Kinematic capabilities for areas with limited network connectivity.</p>
            </div>
          </li>
        </ul>
      </div>

      <!-- Card 2: Advanced Sensors -->
      <div class="scroll-animate opacity-0 translate-y-[20px] transition-all duration-1000 ease-out" style="transition-delay: 300ms;">
        {/* Uniform Image Sizing Container */}
        <div class="relative h-[300px] xl:h-[350px] w-full rounded-2xl overflow-hidden mb-8 shadow-2xl border border-white/10 group">
          <img 
            src="https://images.unsplash.com/photo-1583508915901-b5f84c1dcde1?q=80&w=1000&auto=format&fit=crop" 
            alt="Advanced Drone Camera Payload" 
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-1000 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#101820] to-transparent opacity-80"></div>
          <div class="absolute bottom-0 left-0 p-6 xl:p-8">
            <div class="flex items-center gap-3 mb-2">
              <div class="w-10 h-10 rounded-full bg-[#FFC62F] flex items-center justify-center text-[#17212B] font-bold shadow-lg">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/></svg>
              </div>
              <h3 class="text-xl xl:text-2xl font-bold text-white">Advanced Sensors</h3>
            </div>
          </div>
        </div>

        <ul class="space-y-5 px-2">
          <li class="flex items-start gap-4 group">
            <span class="text-[#FFC62F] mt-1 text-lg group-hover:scale-125 transition-transform">✓</span>
            <div>
              <h4 class="text-white font-bold text-lg">Thermal Imaging Cameras</h4>
              <p class="text-white/60 text-sm mt-1 leading-relaxed">Radiometric thermal sensors for hotspot detection in solar plants and power grids.</p>
            </div>
          </li>
          <li class="flex items-start gap-4 group">
            <span class="text-[#FFC62F] mt-1 text-lg group-hover:scale-125 transition-transform">✓</span>
            <div>
              <h4 class="text-white font-bold text-lg">LiDAR & Mapping Sensors</h4>
              <p class="text-white/60 text-sm mt-1 leading-relaxed">Laser scanning payloads for high-density 3D terrain modeling and vegetation mapping.</p>
            </div>
          </li>
          <li class="flex items-start gap-4 group">
            <span class="text-[#FFC62F] mt-1 text-lg group-hover:scale-125 transition-transform">✓</span>
            <div>
              <h4 class="text-white font-bold text-lg">High-Resolution RGB & Zoom</h4>
              <p class="text-white/60 text-sm mt-1 leading-relaxed">Optical zoom cameras for capturing minute hardware defects from safe standoff distances.</p>
            </div>
          </li>
        </ul>
      </div>

      <!-- Card 3: Software & Analytics (NEW) -->
      <div class="scroll-animate opacity-0 translate-x-[20px] transition-all duration-1000 ease-out" style="transition-delay: 450ms;">
        {/* Uniform Image Sizing Container */}
        <div class="relative h-[300px] xl:h-[350px] w-full rounded-2xl overflow-hidden mb-8 shadow-2xl border border-white/10 group">
          <img 
            src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?q=80&w=800&auto=format&fit=crop" 
            alt="Data Analytics Interface" 
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-1000 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#101820] to-transparent opacity-80"></div>
          <div class="absolute bottom-0 left-0 p-6 xl:p-8">
            <div class="flex items-center gap-3 mb-2">
              <div class="w-10 h-10 rounded-full bg-[#FFC62F] flex items-center justify-center text-[#17212B] font-bold shadow-lg">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
              </div>
              <h3 class="text-xl xl:text-2xl font-bold text-white">Software & Analytics</h3>
            </div>
          </div>
        </div>

        <ul class="space-y-6 px-2 pt-2">
          <li class="flex items-center gap-4 group">
            <span class="text-[#FFC62F] text-lg group-hover:scale-125 transition-transform">✓</span>
            <h4 class="text-white font-bold text-[17px]">Flight planning software</h4>
          </li>
          <li class="flex items-center gap-4 group">
            <span class="text-[#FFC62F] text-lg group-hover:scale-125 transition-transform">✓</span>
            <h4 class="text-white font-bold text-[17px]">GIS mapping platforms</h4>
          </li>
          <li class="flex items-center gap-4 group">
            <span class="text-[#FFC62F] text-lg group-hover:scale-125 transition-transform">✓</span>
            <h4 class="text-white font-bold text-[17px]">Inspection analytics tools</h4>
          </li>
          <li class="flex items-center gap-4 group">
            <span class="text-[#FFC62F] text-lg group-hover:scale-125 transition-transform">✓</span>
            <h4 class="text-white font-bold text-[17px]">Report generation systems</h4>
          </li>
          <li class="flex items-center gap-4 group">
            <span class="text-[#FFC62F] text-lg group-hover:scale-125 transition-transform">✓</span>
            <h4 class="text-white font-bold text-[17px]">AI/ML Based software</h4>
          </li>
        </ul>
      </div>

    </div>
  </div>
</section>