---
/**
 * Drop-in replacement for <img> that takes the same public-style path
 * ("/images/...") and, when the file lives in src/assets/images, serves it
 * through Astro's image pipeline: resized WebP variants with srcset, plus
 * width/height so the layout doesn't shift while it loads. Any other src
 * (remote URLs, files still in public/) renders as a plain <img>.
 */
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';
import { getImage } from 'astro:assets';

type Props = Omit<HTMLAttributes<'img'>, 'src'> & {
  src: string;
  alt: string;
  /**
   * How wide the image renders, so the browser can pick the smallest variant.
   * Defaults to full width for priority (hero) images, half width on desktop otherwise.
   */
  sizes?: string;
};

const ASSETS = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/**/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
// Candidate widths; any wider than the source image are dropped
const WIDTHS = [128, 256, 400, 800, 1200, 1600, 2400];

const { src, sizes: sizesProp, ...attrs } = Astro.props;
const sizes = sizesProp ?? (attrs.fetchpriority === 'high' ? '100vw' : '(min-width: 1024px) 50vw, 100vw');
const asset = src.startsWith('/images/')
  ? ASSETS[`/src/assets${decodeURI(src)}`]?.default
  : undefined;

let image: { src: string; srcSet?: string; width?: number; height?: number } = { src };
if (asset) {
  const widths = WIDTHS.filter((w) => w < asset.width).concat(asset.width);
  const result = await getImage({ src: asset, widths, sizes, format: 'webp', quality: 80 });
  image = {
    src: result.src,
    srcSet: result.srcSet.attribute,
    width: asset.width,
    height: asset.height,
  };
}
---

<img
  src={image.src}
  srcset={image.srcSet}
  sizes={image.srcSet ? sizes : undefined}
  width={image.width}
  height={image.height}
  {...attrs}
/>
