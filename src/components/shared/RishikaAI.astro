---
// Reusable Rishika AI Platform Component
---

<section id="rishika-ai" class="relative py-32 lg:py-40 overflow-hidden bg-[#17212B]">
  
  <!-- Background Image with Parallax/Zoom effect -->
  <div class="absolute inset-0 z-0">
    <img 
      src="https://images.unsplash.com/photo-1541888086425-d81bb19240f5?q=80&w=2500&auto=format&fit=crop" 
      alt="Aerial View of Construction Site" 
      class="w-full h-full object-cover opacity-40 scale-105"
    />
  </div>
  
  <!-- Deep Blue/Dark Gradient Overlay -->
  <div class="absolute inset-0 bg-gradient-to-b from-[#17212B]/90 via-[#17212B]/70 to-[#17212B]/90 z-0"></div>

  <!-- Main Content Container -->
  <div class="relative z-10 mx-auto max-w-[1440px] px-6 lg:px-16 flex flex-col items-center text-center">
    
    <!-- Animated Text Block -->
    <div 
      class="repeat-animate max-w-4xl opacity-0 transition-all duration-1000 ease-out"
      data-transform="translateY(40px)"
    >
      <h2 class="text-3xl md:text-5xl lg:text-[52px] font-bold leading-tight text-white tracking-tight">
        The <span class="text-[#FFC62F]">Rishika AI</span> aerial data management platform: where visual data becomes actionable intelligence, giving you clarity, context, and control
      </h2>
      
      <p class="mt-8 text-lg md:text-xl text-white/80 max-w-3xl mx-auto leading-relaxed">
        Powered by proprietary AI/ML algorithms, our platform automates defect classification, processes high-density LiDAR models, and delivers predictive maintenance reports faster than any traditional method.
      </p>

      <div class="mt-10">
        <a
          href="/rishika-ai"
          class="inline-flex rounded-full bg-[#FFC62F] px-10 py-4 text-[15px] font-bold text-[#17212B] transition-all hover:bg-[#FFD85C] hover:-translate-y-1 hover:shadow-xl"
        >
          Find out more
        </a>
      </div>
    </div>
  </div>
  
  <!-- Animated Diagonal Stripes at the Bottom (Matching the screenshot) -->
  <div class="absolute bottom-0 left-0 w-full h-8 z-10 overflow-hidden">
    <div class="stripe-animation w-[200%] h-full"></div>
  </div>

  <style>
    /* CSS for the continuous sliding diagonal stripes */
    .stripe-animation {
      background: repeating-linear-gradient(
        -45deg,
        #FFFFFF,
        #FFFFFF 20px,
        transparent 20px,
        transparent 40px
      );
      animation: slide-stripes 2s linear infinite;
    }

    @keyframes slide-stripes {
      0% {
        transform: translateX(0);
      }
      100% {
        /* Moves exactly one pattern width (40px) to make it loop seamlessly */
        transform: translateX(-56.5px); 
      }
    }
  </style>
</section>