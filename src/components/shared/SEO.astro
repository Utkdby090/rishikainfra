---
import { SITE_CONFIG } from '../../data/siteConfig';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: string | URL;
  type?: 'website' | 'article';
}

const {
  title,
  // Default description if one isn't provided on the individual page
  description = "Rishika Infra provides enterprise-grade drone inspections, geospatial mapping, and AI-driven analytics for infrastructure and renewable energy.",
  // Default sharing image (1537x807 brand banner)
  image = "/images/rishikainfra.png",
  canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://rishikainfra.com'),
  type = 'website',
} = Astro.props;

// JSON-LD Structured Data for Google Business Graph
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Rishika Infra",
  "url": "https://rishikainfra.com",
  "logo": "https://rishikainfra.com/images/Companylogo/rishikaLogo.png",
  "description": description,
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": SITE_CONFIG.contact.phone,
    "contactType": "customer service",
    "areaServed": "IN",
    "availableLanguage": ["English", "Hindi"]
  }
};
---

<!-- Primary Meta Tags -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph / Facebook / LinkedIn -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />

<!-- JSON-LD Schema (Invisible to users, strictly for Search Engines) -->
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />