---
import '../styles/global.css';
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-white">
    <slot />
    
    <!-- Footer from the video (Dark theme, simple layout) -->
    <footer class="bg-brand-dark text-white pt-16 pb-8 border-t-4 border-brand-yellow">
      <div class="max-w-7xl mx-auto px-4 grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
        <div class="col-span-1 md:col-span-2">
          <h3 class="text-2xl font-bold mb-6 flex items-center gap-2">
            <span class="text-brand-yellow">↗</span> ri RISHIKA INFRA
          </h3>
          <p class="text-gray-400 max-w-sm text-sm">
            C-828, Tower C Alpha Thum, Sec-90,<br/>
            Near Biodiversity Park - 201305<br/><br/>
            +91 9811331744<br/>
            Anurag.singh@rishikainfra.com
          </p>
          <div class="mt-6 flex gap-4">
            <button class="bg-brand-yellow text-brand-dark font-bold px-6 py-2 rounded-full text-sm hover:bg-brand-yellowHover">Contact us</button>
            <button class="border border-white hover:border-brand-yellow text-white hover:text-brand-yellow font-bold px-6 py-2 rounded-full text-sm transition-colors">Book a demo</button>
          </div>
        </div>
        
        <div>
          <ul class="space-y-3 text-sm font-semibold text-gray-300">
            <li><a href="#" class="hover:text-brand-yellow">Power Grid and Utilities</a></li>
            <li><a href="#" class="hover:text-brand-yellow">Capital Projects</a></li>
            <li><a href="#" class="hover:text-brand-yellow">Renewables</a></li>
            <li><a href="#" class="hover:text-brand-yellow">Highway Mapping</a></li>
          </ul>
        </div>
      </div>
      
      <div class="max-w-7xl mx-auto px-4 border-t border-gray-700 pt-8 flex flex-col md:flex-row justify-between items-center text-xs text-gray-500 font-semibold">
        <div class="flex gap-4 mb-4 md:mb-0">
          <a href="#" class="hover:text-white">About</a>
          <a href="#" class="hover:text-white">News</a>
          <a href="#" class="hover:text-white">Careers</a>
          <a href="#" class="hover:text-white">Contact</a>
          <a href="#" class="hover:text-white">Privacy & Cookies</a>
        </div>
        <div>© 2026 Rishika Infra. All Rights Reserved.</div>
      </div>
    </footer>
  </body>
</html>