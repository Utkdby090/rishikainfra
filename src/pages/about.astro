---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/islands/Navbar';
import Differentiators from '../components/shared/Differentiators.astro';
---

<Layout title="About Us | Rishika Infra">
  <Navbar client:load />

  <!-- Hero Section -->
  <section class="relative pt-40 pb-32 bg-[#1D2630] overflow-hidden">
    <img src="https://images.unsplash.com/photo-1508614589041-895b88991e3e?q=80&w=2500&auto=format&fit=crop" class="absolute inset-0 h-full w-full object-cover opacity-20" alt="Drone Pilots" />
    <div class="absolute inset-0 bg-gradient-to-t from-[#17212B] to-transparent"></div>
    
    <div class="relative z-10 mx-auto max-w-[1440px] px-6 lg:px-16 text-center">
      <h1 class="text-4xl md:text-6xl font-extrabold text-white mb-6">Expert pilots and advanced<br/>drone technology, <span class="text-[#FFC62F]">working as one.</span></h1>
      <p class="text-lg text-gray-300 max-w-2xl mx-auto">
        We provide innovative drone inspection solutions that improve operational efficiency, reduce maintenance costs, and enhance asset reliability[cite: 1].
      </p>
    </div>
  </section>

  <!-- Mission & Fleet -->
  <section class="bg-white py-24">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-16 grid lg:grid-cols-2 gap-16 items-center">
      <div>
        <h2 class="text-3xl md:text-4xl font-bold text-[#17212B] mb-6">Our Commitment & Quality</h2>
        <p class="text-gray-600 mb-6 leading-relaxed">
          Rishika Infra is a leading provider of drone-based inspection and surveying services, delivering innovative solutions for power utilities, infrastructure, telecommunications, renewable energy, and industrial sectors[cite: 1].
        </p>
        <p class="text-gray-600 mb-8 leading-relaxed">
          Safety remains our highest priority. Our team follows strict standard operating procedures, aviation regulations, and risk assessment protocols during all operations[cite: 1].
        </p>
        
        <h3 class="text-xl font-bold text-[#17212B] mb-4">Our Technology Fleet</h3>
        <ul class="space-y-3">
          <li class="flex items-center gap-3 text-gray-700 font-medium">
            <span class="text-[#0070BA] font-bold">✓</span> DGCA Type-Certified SURVEYXK platforms[cite: 1]
          </li>
          <li class="flex items-center gap-3 text-gray-700 font-medium">
            <span class="text-[#0070BA] font-bold">✓</span> PPK and RTK-enabled sub-centimeter drones[cite: 1]
          </li>
          <li class="flex items-center gap-3 text-gray-700 font-medium">
            <span class="text-[#0070BA] font-bold">✓</span> High-resolution RGB, Thermal, and LiDAR sensors[cite: 1]
          </li>
        </ul>
      </div>
      
      <div class="grid grid-cols-2 gap-4">
        <img src="https://images.unsplash.com/photo-1581092160562-40aa08e78837?q=80&w=600&auto=format&fit=crop" class="rounded-lg shadow-lg w-full h-64 object-cover" alt="Engineer inspecting data" />
        <img src="https://images.unsplash.com/photo-1503387762-592deb58ef4e?q=80&w=600&auto=format&fit=crop" class="rounded-lg shadow-lg w-full h-64 object-cover mt-12" alt="Infrastructure Construction" />
      </div>
    </div>
  </section>

  <!-- Process Steps -->
  <section class="bg-gray-50 py-24 border-y border-gray-200">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-16 text-center">
      <p class="text-sm font-bold uppercase tracking-[0.25em] text-gray-500 mb-4">HOW WE WORK</p>
      <h2 class="text-3xl md:text-4xl font-bold text-[#17212B] mb-16">Project Execution Process</h2>
      
      <div class="grid md:grid-cols-4 gap-8 relative">
        <!-- Connecting Line -->
        <div class="hidden md:block absolute top-8 left-[12%] right-[12%] h-[2px] bg-gray-300 z-0"></div>
        
        {[{
          step: "1", title: "Project Planning", desc: "Site assessment, risk evaluation, and flight mission planning."
        }, {
          step: "2", title: "Data Acquisition", desc: "Drone deployment for visual, thermal, and geospatial data collection."
        }, {
          step: "3", title: "Data Processing", desc: "Image analysis, defect classification, mapping and modelling."
        }, {
          step: "4", title: "Reporting", desc: "Detailed inspection reports and maintenance recommendations."
        }].map((item) => (
          <div class="relative z-10 bg-white p-8 rounded-xl shadow-sm border border-gray-100 hover:-translate-y-2 transition-transform">
            <div class="w-16 h-16 mx-auto bg-[#FFC62F] text-[#17212B] rounded-full flex items-center justify-center text-2xl font-black mb-6 shadow-md">
              {item.step}
            </div>
            <h3 class="text-xl font-bold text-[#17212B] mb-3">{item.title}</h3>
            <p class="text-sm text-gray-600">{item.desc}[cite: 1]</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Differentiators />

</Layout>