---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Differentiators from '../components/shared/Differentiators.astro';
---

<Layout title="About Us | Rishika Infra">
  <Navbar />

 <!-- =========================================================
       HERO SECTION
       ========================================================= -->
  <section class="relative min-h-screen flex items-center justify-center pt-20 overflow-hidden bg-[#17212B]">
    {/* Background Image: Adjust the src to point to your actual dark drone image */}
    <img fetchpriority="high" 
      src="https://images.unsplash.com/photo-1508614589041-895b88991e3e?q=80&w=2500&auto=format&fit=crop" 
      class="absolute inset-0 h-full w-full object-cover opacity-30" 
      alt="Expert Drone Pilots" 
    />
    
    {/* Dark Overlay Gradient to make text pop */}
    <div class="absolute inset-0 bg-gradient-to-b from-[#17212B]/80 via-[#17212B]/50 to-[#17212B]"></div>
    
    <div class="relative z-10 mx-auto max-w-[1440px] px-6 lg:px-16 w-full flex flex-col items-center text-center">
      <div class="max-w-[900px] repeat-animate" data-transform="translateY(30px)">
        
        <h1 class="text-[42px] font-extrabold leading-[1.1] tracking-tight text-white md:text-[56px] lg:text-[64px] mb-6">
          Expert pilots and advanced <br/>
          drone technology, <span class="text-[#FFC62F]">working as one.</span>
        </h1>
        
        <p class="text-[17px] md:text-[19px] leading-relaxed text-white/80 mx-auto max-w-[700px]">
          We provide innovative drone inspection solutions that improve operational efficiency, reduce maintenance costs, and enhance asset reliability.
        </p>

      </div>
    </div>
    
    <!-- Optional: Scroll Down Arrow Indicator -->
    <a
      href="#commitment"
      class="absolute bottom-8 left-1/2 z-20 flex -translate-x-1/2 flex-col items-center text-white"
      aria-label="Scroll down"
    >
      <div
        class="flex h-14 w-14 items-center justify-center rounded-full border border-[#FFC62F] bg-black/10 backdrop-blur-sm transition-colors hover:bg-[#FFC62F] hover:text-[#17212B]"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-current">
          <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </div>
    </a>
  </section>
  
  <!-- Mission & Fleet -->
  <section id="commitment" class="bg-white py-24 border-b border-gray-100">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-16 grid lg:grid-cols-2 gap-16 items-center">
      <div>
        <h2 class="text-3xl md:text-4xl font-bold text-[#17212B] mb-6">Our Commitment & Quality</h2>
        <p class="text-gray-600 mb-6 leading-relaxed">
          Rishika Infra is a leading provider of drone-based inspection and surveying services, delivering innovative solutions for power utilities, infrastructure, telecommunications, renewable energy, and industrial sectors.
        </p>
        <p class="text-gray-600 mb-8 leading-relaxed">
          Safety remains our highest priority. Our team follows strict standard operating procedures, aviation regulations, and risk assessment protocols during all operations.
        </p>
        
        <h3 class="text-xl font-bold text-[#17212B] mb-4">Our Technology Fleet</h3>
        <ul class="space-y-3">
          <li class="flex items-center gap-3 text-gray-700 font-medium">
            <span class="text-[#0070BA] font-bold">✓</span> DGCA Type-Certified SURVEYXK platforms
          </li>
          <li class="flex items-center gap-3 text-gray-700 font-medium">
            <span class="text-[#0070BA] font-bold">✓</span> PPK and RTK-enabled sub-centimeter drones
          </li>
          <li class="flex items-center gap-3 text-gray-700 font-medium">
            <span class="text-[#0070BA] font-bold">✓</span> High-resolution RGB, Thermal, and LiDAR sensors
          </li>
        </ul>
      </div>
      
      <div class="grid grid-cols-2 gap-4">
        <img loading="lazy" decoding="async" src="https://images.unsplash.com/photo-1581092160562-40aa08e78837?q=80&w=600&auto=format&fit=crop" class="rounded-lg shadow-lg w-full h-64 object-cover" alt="Engineer inspecting data" />
        <img loading="lazy" decoding="async" src="https://images.unsplash.com/photo-1503387762-592deb58ef4e?q=80&w=600&auto=format&fit=crop" class="rounded-lg shadow-lg w-full h-64 object-cover mt-12" alt="Infrastructure Construction" />
      </div>
    </div>
  </section>

  <!-- Process Steps -->
  <section class="bg-gray-50 py-24 border-y border-gray-200 overflow-hidden">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-16 text-center">
      <p class="text-sm font-bold uppercase tracking-[0.25em] text-gray-500 mb-4">HOW WE WORK</p>
      <h2 class="text-3xl md:text-4xl font-bold text-[#17212B] mb-20">Project Execution Process</h2>
      
      <div class="grid md:grid-cols-4 gap-8 relative">
        <!-- Connecting Line -->
        <div class="hidden md:block absolute top-10 left-[12%] right-[12%] h-[2px] bg-gray-200 z-0"></div>
        
        {[{
          step: "1", title: "Project Planning", desc: "Site assessment, risk evaluation, and flight mission planning."
        }, {
          step: "2", title: "Data Acquisition", desc: "Drone deployment for visual, thermal, and geospatial data collection."
        }, {
          step: "3", title: "Data Processing", desc: "Image analysis, defect classification, mapping and modelling."
        }, {
          step: "4", title: "Reporting", desc: "Detailed inspection reports and maintenance recommendations."
        }].map((item, index) => (
          
          /* 
            CARD UPGRADES: 
            - opacity-0 and -translate-x-12 are the starting states for the animation
            - transition-all duration-700 ease-out handles the smooth sliding
            - transition-delay is calculated by index so they slide in 1 by 1
          */
          <div 
            class="process-card opacity-0 -translate-x-12 transition-all duration-700 ease-out relative z-10 bg-white p-8 md:p-10 rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.06)] border border-gray-100 hover:-translate-y-2 hover:shadow-[0_20px_40px_rgb(0,0,0,0.12)] group"
            style={`transition-delay: ${index * 150}ms;`}
          >
            <div class="w-20 h-20 mx-auto bg-white border-4 border-gray-50 text-[#17212B] rounded-full flex items-center justify-center text-3xl font-black mb-8 shadow-[0_4px_20px_rgba(255,198,47,0.4)] transition-colors duration-300 group-hover:bg-[#FFC62F] group-hover:border-white">
              {item.step}
            </div>
            <h3 class="text-xl font-bold text-[#17212B] mb-4">{item.title}</h3>
            <p class="text-[15px] leading-relaxed text-gray-600">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Differentiators />

  <style>
    /* This makes all anchor links (#) on this page glide smoothly! */
    html {
      scroll-behavior: smooth;
    }
  </style>

</Layout>

<!-- Client-side script to trigger the slide-in animation on scroll -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          // When the card comes into view, remove the offset and hidden opacity
          entry.target.classList.remove('opacity-0', '-translate-x-12');
          entry.target.classList.add('opacity-100', 'translate-x-0');
          
          // Stop observing once it has animated in
          observer.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.2 // Trigger whenF 20% of the card is visible
    });

    const cards = document.querySelectorAll('.process-card');
    cards.forEach((card) => observer.observe(card));
  });
</script>