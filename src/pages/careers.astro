---
import Layout from '../layouts/Layout.astro';
---

<Layout solidHeader description="Careers at Rishika Infra for drone pilots, GIS analysts, civil engineers and AI specialists. Send us your resume." title="Careers | Rishika Infra">

  <section class="pt-32 pb-24 bg-gray-50 min-h-[70vh] flex items-center">
    <div class="mx-auto max-w-[800px] px-6 lg:px-8 text-center">
      <div class="w-16 h-16 bg-brand-yellow/20 rounded-full flex items-center justify-center mx-auto mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#17212B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </div>
      
      <h1 class="text-4xl md:text-5xl font-extrabold text-brand-ink mb-6">
        Join the Team
      </h1>
      <p class="text-lg text-gray-600 leading-relaxed mb-10">
        We are always looking for talented drone pilots, GIS analysts, civil engineers, and AI specialists to join our growing team. While we don't have open postings at this exact moment, we'd love to see your resume.
      </p>
      
      <a href="mailto:info@rishikainfra.com" class="inline-flex rounded-full bg-brand-ink px-8 py-3.5 font-bold text-white transition-all hover:bg-brand-blue">
        Email Your Resume
      </a>
    </div>
  </section>
</Layout>