---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/islands/Navbar';
import NewsSlider from '../components/islands/NewsSlider'; // Import your new component
---

<Layout hideCTA title="Contact Us | Rishika Infra">
  <Navbar client:load />

  <!-- =========================================================
       HERO SECTION
       ========================================================= -->
  <section class="relative min-h-[50vh] flex items-center pt-20 overflow-hidden bg-[#1D2630]">
    {/* Background Image: Aerial/Office Abstract */}
    <img 
      src="https://images.unsplash.com/photo-1497366216548-37526070297c?q=80&w=2500&auto=format&fit=crop" 
      class="absolute inset-0 h-full w-full object-cover opacity-20 scale-105 contrast-125 grayscale" 
      alt="Enterprise Office" 
    />
    <div class="absolute inset-0 bg-gradient-to-t from-[#17212B] to-transparent"></div>
    
    <div class="relative z-10 mx-auto max-w-[1440px] px-6 lg:px-16 w-full text-center">
      <div class="max-w-[800px] mx-auto repeat-animate" data-transform="translateY(30px)">
        <p class="text-[12px] font-bold uppercase tracking-[0.3em] text-[#FFC62F] mb-6">
          Support & Sales
        </p>
        <h1 class="text-[42px] font-extrabold leading-[1.05] tracking-tight text-white md:text-[56px] mb-6">
          Ready to elevate your <br/>
          <span class="text-[#FFC62F]">infrastructure data?</span>
        </h1>
        <p class="text-[17px] leading-relaxed text-white/80 max-w-[600px] mx-auto">
          Whether you need a one-off structural inspection, a massive topographical survey, or a custom AI traffic analytics deployment, our team of experts is ready to assist.
        </p>
      </div>
    </div>
  </section>

  <!-- =========================================================
       CONTACT LAYOUT (Split: Info & Form)
       ========================================================= -->
  <section class="bg-gray-50 py-24 overflow-hidden relative">
    
    {/* Subtle Background Accent */}
    <div class="absolute top-0 right-0 w-1/3 h-full bg-white skew-x-[-20deg] origin-bottom-right z-0"></div>

    <div class="relative z-10 mx-auto max-w-[1440px] px-6 lg:px-16 grid lg:grid-cols-12 gap-16 lg:gap-20 items-start">
      
      {/* ================= LEFT: CONTACT INFO ================= */}
      <div class="lg:col-span-5 repeat-animate" data-transform="translateX(-40px)">
        <h2 class="text-3xl md:text-4xl font-extrabold text-[#17212B] mb-6">
          Let's discuss your next project.
        </h2>
        <p class="text-gray-600 leading-relaxed mb-12">
          Fill out the form to request a demo, get a quote, or speak directly with our engineering and surveying teams. We aim to respond to all inquiries within 24 hours.
        </p>

        <div class="space-y-8">
          
          {/* Email */}
          <div class="flex items-start gap-5 group">
            <div class="w-12 h-12 rounded-full border-2 border-gray-200 flex items-center justify-center shrink-0 group-hover:border-[#FFC62F] group-hover:bg-[#FFC62F]/10 transition-all duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0070BA" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </div>
            <div>
              <p class="text-sm font-bold tracking-wider text-gray-500 uppercase mb-1">Email Us</p>
              <a href="mailto:contact@rishikainfra.com" class="text-lg font-bold text-[#17212B] hover:text-[#0070BA] transition-colors">
                contact@rishikainfra.com
              </a>
            </div>
          </div>

          {/* Phone */}
          <div class="flex items-start gap-5 group">
            <div class="w-12 h-12 rounded-full border-2 border-gray-200 flex items-center justify-center shrink-0 group-hover:border-[#FFC62F] group-hover:bg-[#FFC62F]/10 transition-all duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0070BA" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div>
              <p class="text-sm font-bold tracking-wider text-gray-500 uppercase mb-1">Call Us</p>
              <p class="text-lg font-bold text-[#17212B]">
                +91 (123) 456-7890
              </p>
            </div>
          </div>

          {/* Office */}
          <div class="flex items-start gap-5 group">
            <div class="w-12 h-12 rounded-full border-2 border-gray-200 flex items-center justify-center shrink-0 group-hover:border-[#FFC62F] group-hover:bg-[#FFC62F]/10 transition-all duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0070BA" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div>
              <p class="text-sm font-bold tracking-wider text-gray-500 uppercase mb-1">Headquarters</p>
              <p class="text-lg font-bold text-[#17212B] leading-snug">
                Rishika Infra Pvt. Ltd.<br/>
                <span class="text-gray-600 font-normal text-base">Corporate Office Address Line 1<br/>City, State, ZIP Code</span>
              </p>
            </div>
          </div>

        </div>
      </div>

      {/* ================= RIGHT: THE FORM ================= */}
      <div class="lg:col-span-7 repeat-animate" data-transform="translateX(40px)">
        <div class="bg-white p-8 md:p-12 rounded-3xl shadow-[0_20px_50px_rgba(0,0,0,0.08)] border border-gray-100">
          
          <form class="space-y-6">
            <div class="grid md:grid-cols-2 gap-6">
              {/* First Name */}
              <div class="space-y-2">
                <label for="firstName" class="text-sm font-bold text-[#17212B]">First Name *</label>
                <input type="text" id="firstName" name="firstName" required class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-[#0070BA] focus:ring-1 focus:ring-[#0070BA] outline-none transition-all bg-gray-50 focus:bg-white" placeholder="John" />
              </div>
              {/* Last Name */}
              <div class="space-y-2">
                <label for="lastName" class="text-sm font-bold text-[#17212B]">Last Name *</label>
                <input type="text" id="lastName" name="lastName" required class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-[#0070BA] focus:ring-1 focus:ring-[#0070BA] outline-none transition-all bg-gray-50 focus:bg-white" placeholder="Doe" />
              </div>
            </div>

            <div class="grid md:grid-cols-2 gap-6">
              {/* Work Email */}
              <div class="space-y-2">
                <label for="email" class="text-sm font-bold text-[#17212B]">Work Email *</label>
                <input type="email" id="email" name="email" required class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-[#0070BA] focus:ring-1 focus:ring-[#0070BA] outline-none transition-all bg-gray-50 focus:bg-white" placeholder="john@company.com" />
              </div>
              {/* Company */}
              <div class="space-y-2">
                <label for="company" class="text-sm font-bold text-[#17212B]">Company Name</label>
                <input type="text" id="company" name="company" class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-[#0070BA] focus:ring-1 focus:ring-[#0070BA] outline-none transition-all bg-gray-50 focus:bg-white" placeholder="Acme Corp" />
              </div>
            </div>

            {/* Interest Dropdown */}
            <div class="space-y-2">
              <label for="service" class="text-sm font-bold text-[#17212B]">What service are you interested in?</label>
              <div class="relative">
                <select id="service" name="service" class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-[#0070BA] focus:ring-1 focus:ring-[#0070BA] outline-none transition-all bg-gray-50 focus:bg-white appearance-none cursor-pointer">
                  <option value="" disabled selected>Select a primary service...</option>
                  <option value="powerline">Power Grid & Transmission Inspection</option>
                  <option value="renewables">Solar & Wind Plant Inspection</option>
                  <option value="geospatial">Geospatial Mapping & LiDAR</option>
                  <option value="infrastructure">Infrastructure & Road Projects</option>
                  <option value="traffic">Traffic Management & AI Analytics</option>
                  <option value="telecom">Telecom Tower Structural Audits</option>
                  <option value="other">Other / General Inquiry</option>
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-gray-500">
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </div>
              </div>
            </div>

            {/* Message */}
            <div class="space-y-2">
              <label for="message" class="text-sm font-bold text-[#17212B]">Project Details or Message</label>
              <textarea id="message" name="message" rows="4" class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-[#0070BA] focus:ring-1 focus:ring-[#0070BA] outline-none transition-all bg-gray-50 focus:bg-white resize-y" placeholder="Tell us about the scope of your project..."></textarea>
            </div>

            {/* Submit Button */}
            <div class="pt-2">
              <button type="submit" class="w-full flex justify-center items-center gap-2 rounded-full bg-[#FFC62F] px-8 py-4 font-bold text-[#17212B] transition-all hover:bg-[#FFD85C] hover:-translate-y-1 shadow-md hover:shadow-lg">
                Submit Request
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </button>
            </div>
            
          </form>
          
          <p class="text-xs text-gray-400 text-center mt-6">
            By submitting this form, you agree to our privacy policy. Your data will not be shared with third parties.
          </p>

        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       NEWS SLIDER
       ========================================================= -->
  <NewsSlider client:visible />

</Layout>