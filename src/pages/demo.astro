---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/islands/Navbar';
import ContactForm from '../components/islands/ContactForm';
import { SITE_CONFIG } from '../data/siteConfig';
---

<Layout title="Book a Demo | Rishika Infra">
  
  <!-- Solid Dark Background behind the Navbar -->
  <div class="absolute top-0 left-0 w-full h-[92px] bg-[#17212B] z-20 border-b border-white/10"></div>
  
  <Navbar client:load />

  <!-- Added pt-[92px] to push the split-screen content below the header -->
  <div class="flex flex-col lg:flex-row min-h-screen bg-[#F8F9FA] pt-[92px]">
    
    <!-- Left Column: Context & Addresses -->
    <div class="lg:w-1/2 flex flex-col">
      
      <!-- Top Half: Dark Image Background -->
      <div class="relative px-8 lg:px-16 py-24 flex-grow flex items-center min-h-[500px]">
        <img src="https://images.unsplash.com/photo-1541888086425-d81bb19240f5?q=80&w=1200&auto=format&fit=crop" class="absolute inset-0 h-full w-full object-cover" alt="Data platform dashboard" />
        <div class="absolute inset-0 bg-[#17212B]/80 mix-blend-multiply"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-[#17212B] to-transparent"></div>
        
        <div class="relative z-10">
          <h1 class="text-4xl lg:text-6xl font-extrabold text-white mb-6 tracking-tight">Book a demo</h1>
          <p class="text-lg text-white/90 leading-relaxed max-w-lg">
            See the power of our geospatial data platform in action. Schedule a personalized walkthrough with our technical engineers to understand how Rishika Infra can digitize and protect your specific assets.
          </p>
          <p class="text-lg text-white/90 leading-relaxed max-w-lg mt-4">
            Fill out the form to request your tailored demonstration.
          </p>
        </div>
      </div>

      <!-- Bottom Half: Office Locations -->
      <div class="bg-white px-8 lg:px-16 py-16 grid grid-cols-1 sm:grid-cols-2 gap-12">
        <div>
          <h3 class="text-xl font-bold text-[#FFC62F] uppercase mb-4 tracking-wider">Corporate HQ</h3>
          <p class="text-[#17212B] font-medium leading-relaxed">
            C-828, Tower C Alpha Thum,<br/>
            Sec-90, Near Biodiversity Park,<br/>
            Noida - 201305
          </p>
          <a href={`tel:${SITE_CONFIG.contact.phone.replace(/\s+/g, '')}`} class="block mt-4 text-[#17212B] hover:text-[#0070BA] transition-colors">{SITE_CONFIG.contact.phone}</a>
        </div>
        <div>
          <h3 class="text-xl font-bold text-[#FFC62F] uppercase mb-4 tracking-wider">Email Us</h3>
          <p class="text-[#17212B] font-medium leading-relaxed">
            For general inquiries, RFQs, and enterprise support:
          </p>
          <a href={`mailto:${SITE_CONFIG.contact.email}`} class="block mt-4 text-[#0070BA] font-bold hover:underline transition-colors">{SITE_CONFIG.contact.email}</a>
        </div>
      </div>
      
    </div>

    <!-- Right Column: The Form -->
    <div class="lg:w-1/2 bg-[#F8F9FA] px-6 lg:px-16 py-16">
      <div class="max-w-xl mx-auto">
        <ContactForm formType="demo" client:load />
      </div>
    </div>
    
  </div>
</Layout>