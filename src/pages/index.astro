---
import Img from '../components/shared/Img.astro';
import Layout from "../layouts/Layout.astro";
import ClientCarousel from "../components/ClientCarousel.astro";
import SolutionsGrid from "../components/shared/SolutionsGrid.astro";
import FleetAndEquipment from "../components/shared/FleetAndEquipment.astro";
import Differentiators from "../components/shared/Differentiators.astro";
import StatsBand from "../components/StatsBand.astro";
import ProjectMap from "../components/ProjectMap.astro";
import CaseStudies from "../components/CaseStudies.astro";
import VideoLightbox from "../components/VideoLightbox.astro";
---

<Layout description="Rishika Infra delivers drone inspections, LiDAR mapping and AI analytics for power grids, renewables, roads and telecom towers across India." title="Rishika Infra | Aerial Inspection & GIS">
  
  <!-- =========================================================
       HERO
       ========================================================= -->
  <section
    class="relative min-h-screen overflow-hidden bg-brand-slate"
  >
    <!-- Background video -->
    <video
      poster="/videos/WebsiteVideo-poster.webp"
      data-autopause
      class="absolute inset-0 h-full w-full object-cover"
      autoplay
      muted
      loop
      playsinline
      aria-hidden="true"
    >
      <source src="/videos/WebsiteVideo.mp4" type="video/mp4" />
    </video>

    <!-- Dark overlay -->
    <div class="absolute inset-0 bg-brand-ink/10 pointer-events-none"></div>

    <!-- Strong left-side gradient -->
    <div
      class="absolute inset-0 pointer-events-none"
      style="
        background:
          linear-gradient(
            90deg,
            rgba(20, 29, 38, 0.96) 0%,
            rgba(20, 29, 38, 0.85) 29%,
            rgba(20, 29, 38, 0.48) 55%,
            rgba(20, 29, 38, 0.08) 100%
          );
      "
    >
    </div>

    


    <!-- =======================================================
         HERO CONTENT
         ======================================================= -->
    <div
      class="relative z-10 mx-auto flex min-h-screen max-w-[1440px] items-center px-6 pb-24 pt-28 lg:px-16 pointer-events-none"
    >
      <div class="min-w-0 max-w-[760px] pointer-events-auto">
        <h1
          class="max-w-[730px] text-[48px] font-extrabold leading-[1.02] tracking-[-0.035em] text-white sm:text-[58px] md:text-[68px] lg:text-[72px]"
        >
          Safer, smarter
          <br />
          inspections with
          <br />
          <span class="text-brand-yellow"> powerful aerial data </span>
        </h1>

        <!-- Yellow line -->
        <div class="mt-7 h-[3px] w-[470px] max-w-full bg-brand-yellow"></div>

        <p
          class="mt-6 max-w-[690px] text-[17px] leading-[1.7] text-white/90 md:text-[18px]"
        >
          Transform how you inspect and manage your assets. Rishika Infra pairs
          expert drone inspection services with powerful aerial data management
          to provide rapid, reliable insight across industries. The result:
          reduced downtime, enhanced safety, and smarter decisions.
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-6">
          <a
            href="/contact"
            class="inline-flex items-center justify-center rounded-full bg-brand-yellow px-9 py-4 text-[15px] font-bold text-brand-ink transition-all hover:bg-brand-yellow-light hover:shadow-xl hover:-translate-y-0.5"
          >
            Get in touch
          </a>
          <VideoLightbox src="/videos/WebsiteVideo.mp4" poster="/videos/WebsiteVideo-poster.webp" />
        </div>
      </div>
    </div>

    <!-- =======================================================
         SCROLL INDICATOR
         ======================================================= -->
    <a
      href="#about"
      class="absolute bottom-5 left-1/2 z-20 flex -translate-x-1/2 flex-col items-center text-white"
      aria-label="Scroll down"
    >
      <div
        class="flex h-16 w-16 items-center justify-center rounded-full border border-brand-yellow bg-black/10 backdrop-blur-sm transition-colors hover:bg-brand-yellow hover:text-brand-ink"
      >
        <svg
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          class="text-current"
        >
          <path
            d="M6 9L12 15L18 9"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </div>
    </a>
  </section>

  <!-- =========================================================
       CLIENTS (INTERACTIVE CAROUSEL)
       ========================================================= -->
  <section class="bg-white">
    <ClientCarousel />
  </section>

  <!-- =========================================================
       WHO WE ARE
       ========================================================= -->
  <section id="about" class="bg-white py-24">
    <div class="mx-auto max-w-4xl px-6 text-center">
      <p class="text-sm font-bold uppercase tracking-[0.25em] text-gray-500">
        WHO WE ARE
      </p>

      <h2
        class="mt-5 text-4xl font-bold tracking-tight text-brand-ink md:text-5xl"
      >
        Trusted leader in drone inspections and aerial data management
      </h2>

      <p class="mt-7 text-lg leading-8 text-gray-600">
        Rishika Infra transforms the way asset-intensive industries inspect,
        manage, and maintain critical infrastructure. We combine specialist
        pilots, advanced drone technology, and RTK/PPK systems to deliver safe,
        actionable insights that reduce risk and improve performance.
      </p>

      
    </div>
  </section>

  <!-- =========================================================
       IN NUMBERS
       ========================================================= -->
  <StatsBand />

  <!-- =========================================================
       SOLUTIONS
       ========================================================= -->
  <SolutionsGrid />

  <!-- =========================================================
       FLEET & EQUIPMENT (Includes 3 Cards: Drones, Sensors, Software)
       ========================================================= -->
  <FleetAndEquipment />

 <!-- =========================================================
       PILOTS & FLEET (Straight Rectangular Layout)
       ========================================================= -->
  <section class="bg-brand-ink py-32 overflow-hidden border-t border-white/10">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-16 grid lg:grid-cols-2 gap-16 lg:gap-24 items-center">

      <!-- CUSTOM COMPOSITE GRAPHIC (Left - Staggered Animations) -->
      <div class="relative h-[550px] w-full flex justify-center items-center">
        
        <!-- Dashed Circle -->
        <div 
          class="absolute right-[5%] top-1/2 -translate-y-1/2 w-[350px] h-[350px] rounded-full border-2 border-dashed border-brand-yellow opacity-40 z-0 repeat-animate transition-all duration-1000 delay-100" 
          data-transform="translateY(40px)"
        ></div>
        
        <!-- Top Yellow Accent -->
        <div 
          class="absolute top-4 left-[15%] w-16 h-24 bg-brand-yellow z-30 shadow-lg repeat-animate transition-all duration-700 delay-500" 
          data-transform="translateY(-30px)"
        ></div>

        <!-- Back Image (Pilot Team) -->
        <div 
          class="absolute right-[5%] top-12 w-[300px] h-[340px] overflow-hidden shadow-2xl z-10 opacity-90 border-4 border-brand-ink group repeat-animate transition-all duration-1000 delay-200" 
          data-transform="translateX(50px)"
        >
          <Img loading="lazy" decoding="async" 
            src="/images/droneandfleet/dronepilot.webp" 
            alt="Rishika Infra Pilot Team" 
            class="w-full h-full object-cover opacity-80 transition-transform duration-[1.5s] ease-out group-hover:scale-110"
            loading="lazy"
          />
        </div>

        <!-- Front Image (Drone in Flight) -->
        <div 
          class="absolute left-[5%] bottom-12 w-[320px] h-[360px] md:w-[350px] md:h-[380px] overflow-hidden shadow-[30px_0_50px_-15px_rgba(0,0,0,0.7)] z-20 border-[10px] border-white group repeat-animate transition-all duration-1000 delay-300" 
          data-transform="translateY(60px)"
        >
          <Img loading="lazy" decoding="async" 
            src="/images/droneandfleet/drone.webp" 
            alt="Inspection Drone in Flight" 
            class="w-full h-full object-cover transition-transform duration-[1.5s] ease-out group-hover:scale-105"
            loading="lazy"
          />
        </div>

        <!-- Bottom Yellow Accent -->
        <div 
          class="absolute bottom-8 right-[20%] w-16 h-20 bg-brand-yellow z-30 shadow-lg repeat-animate transition-all duration-700 delay-700" 
          data-transform="translateY(30px)"
        ></div>
      </div>

      <!-- TEXT CONTENT (Right - Staggered Waterfall Animation) -->
      <div class="order-1 lg:order-2 flex flex-col items-start justify-center">
        
        <p 
          class="text-sm font-bold uppercase tracking-[0.25em] text-brand-yellow mb-4 repeat-animate transition-all duration-700 delay-100" 
          data-transform="translateX(40px)"
        >
          PILOTS AND FLEET
        </p>
        
        <h2 
          class="text-4xl md:text-5xl font-extrabold text-white mb-8 leading-tight repeat-animate transition-all duration-700 delay-200" 
          data-transform="translateX(40px)"
        >
          Expert pilots and advanced <br class="hidden xl:block" /> drone technology, <br/>
          <span class="text-brand-yellow">working as one</span>
        </h2>
        
        <p 
          class="text-[17px] text-white/70 leading-relaxed mb-6 repeat-animate transition-all duration-700 delay-300" 
          data-transform="translateX(40px)"
        >
          Rishika Infra handles every mission end-to-end, transforming complex, high-risk inspections into fast, reliable aerial intelligence for your critical infrastructure.
        </p>
        
        <p 
          class="text-[17px] text-white/70 leading-relaxed mb-8 repeat-animate transition-all duration-700 delay-400" 
          data-transform="translateX(40px)"
        >
          With a deep understanding of your assets and exact project requirements, we build an inspection program that perfectly fits your needs.
        </p>
        
        <div 
          class="repeat-animate transition-all duration-700 delay-500" 
          data-transform="translateX(40px)"
        >
          <a 
            href="/about" 
            class="inline-flex rounded-full border-2 border-white px-8 py-3 font-bold text-white transition-all hover:bg-white hover:text-brand-ink hover:shadow-[0_0_20px_rgba(255,255,255,0.2)] hover:-translate-y-1"
          >
            Find out more
          </a>
        </div>
        
      </div>

    </div>
  </section>

  <!-- =========================================================
       PROJECT MAP + CASE STUDIES
       ========================================================= -->
  <ProjectMap />
  <CaseStudies />

  <!-- =========================================================
       DIFFERENTIATORS (WHY RISHIKA)
       ========================================================= -->
  <Differentiators />

  <!-- =========================================================
       LOCAL STYLES
       ========================================================= -->
  <style>
    .skew-card {
      transform: skewX(-8deg);
    }

    .skew-content {
      transform: skewX(8deg);
    }
    
    /* Adds a smooth scrolling effect when clicking the downward arrow */
    html {
      scroll-behavior: smooth;
    }
  </style>
</Layout>