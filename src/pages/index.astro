---
import Layout from '../layouts/Layout.astro';
import { SITE_CONFIG } from '../data/siteConfig';
import ClientCarousel from '../components/islands/ClientCarousel';
import Navbar from '../components/islands/Navbar';
---

<Layout title="Rishika Infra | Aerial Inspection & GIS">

  <!-- =========================================================
       TOP ANNOUNCEMENT BAR
       ========================================================= -->
  <div class="relative z-[60] h-[66px] overflow-hidden bg-white">
    <div class="mx-auto flex h-full max-w-[1440px] items-center justify-between px-6 lg:px-16">

      <!-- Left -->
      <div class="flex items-center gap-6">
        <div class="flex items-center gap-3">
          <span class="text-[22px] font-medium tracking-[0.2em] text-[#17324D]">
            
          </span>

          <span class="text-2xl text-[#0077B8]">✦</span>
        </div>

        <div class="hidden h-8 w-px bg-gray-300 md:block"></div>

        <p class="text-sm text-[#1F2937] md:text-[15px]">
          <span class="font-bold">Rishika Infra</span>
          is a leader in aerial inspection and geospatial intelligence.
          <a
            href="#about"
            class="ml-1 font-semibold underline underline-offset-2 transition-colors hover:text-[#0070BA]"
          >
            Read more
          </a>
        </p>
      </div>

      <!-- Right -->
      <div class="hidden items-center gap-8 text-sm font-bold text-[#0070BA] md:flex">
        <a href="#contact" class="transition-colors hover:text-[#17324D]">
          CONTACT US
        </a>

        <a
          href="#demo"
          class="rounded-full bg-[#F7F7F7] px-7 py-3 text-[#111827] transition-all hover:bg-[#E5E7EB]"
        >
          BOOK A DEMO
        </a>
      </div>
    </div>

    <!-- Diagonal blue strip -->
    <div
      class="absolute right-0 top-0 h-full w-[28%] opacity-95"
      style="
        background:
          repeating-linear-gradient(
            55deg,
            #FFFFFF 0px,
            #FFFFFF 26px,
            #0077B8 26px,
            #0077B8 56px
          );
        clip-path: polygon(18% 0, 100% 0, 100% 100%, 0 100%);
      "
    ></div>

    <!-- Keep controls above stripe -->
    <div class="pointer-events-none absolute inset-0"></div>
  </div>


  <!-- =========================================================
       HERO
       ========================================================= -->
  <section class="relative min-h-[calc(100vh-66px)] overflow-hidden bg-[#1D2630]">

    <!-- Background video -->
    <video
      class="absolute inset-0 h-full w-full object-cover"
      autoplay
      muted
      loop
      playsinline
      poster="/images/cyberhawk-hero-poster.jpg"
      aria-hidden="true"
    >
      <source src="public/videos/WebsiteVideo.mp4" type="video/mp4" />
    </video>

    <!-- Dark overlay -->
    <div class="absolute inset-0 bg-[#17212B]/45 pointer-events-none"></div>

    <!-- Strong left-side gradient -->
    <div
      class="absolute inset-0 pointer-events-none"
      style="
        background:
          linear-gradient(
            90deg,
            rgba(20, 29, 38, 0.96) 0%,
            rgba(20, 29, 38, 0.85) 29%,
            rgba(20, 29, 38, 0.48) 55%,
            rgba(20, 29, 38, 0.08) 100%
          );
      "
    ></div>

    <!-- Slight blue tint on the right -->
    <div
      class="absolute inset-0 pointer-events-none"
      style="
        background:
          linear-gradient(
            180deg,
            rgba(6, 24, 38, 0.15) 0%,
            rgba(0, 112, 186, 0.08) 100%
          );
      "
    ></div>

	

    <!-- =======================================================
         NAVIGATION
         ======================================================= -->
	<!-- 	 
    <header class="absolute left-0 right-0 top-0 z-30">
      <div class="mx-auto flex h-[92px] max-w-[1440px] items-center justify-between px-6 lg:px-16">

        
        <a href="/" class="flex items-center">
          <div class="flex items-center gap-3">

            
            <div
              class="flex h-[58px] w-[58px] items-center justify-center rounded-full border-[3px] border-[#FFC62F]"
            >
              <div class="text-[26px] leading-none text-white">
                ≋
              </div>
            </div>

            <div>
              <div class="flex items-center gap-1">
                <span
                  class="text-[22px] font-light tracking-[0.3em] text-white"
                >
                  RISHIKA
                </span>

                <span class="text-[22px] font-extrabold tracking-[0.15em] text-white">
                  INFRA
                </span>

                <sup class="ml-1 text-[7px] text-[#FFC62F]">™</sup>
              </div>

              <p class="mt-0.5 text-[9px] tracking-[0.22em] text-white/75">
                YOUR ASSETS. OUR SOLUTIONS. BETTER DECISIONS.
              </p>

              <p class="mt-1 text-[7px] tracking-[0.28em] text-white/55">
                AERIAL INSPECTION & GEOSPATIAL INTELLIGENCE
              </p>
            </div>

          </div>
        </a>
-->


        <!-- Desktop navigation -->
      <!--  <nav class="hidden items-center gap-8 lg:flex">
          <a
            href="#sectors"
            class="text-[15px] font-semibold text-white transition-colors hover:text-[#FFC62F]"
          >
            SECTORS
          </a>

          <a
            href="#solutions"
            class="text-[15px] font-semibold text-white transition-colors hover:text-[#FFC62F]"
          >
            OUR SOLUTIONS
          </a>

          <a
            href="#platform"
            class="text-[15px] font-semibold text-white transition-colors hover:text-[#FFC62F]"
          >
            PLATFORM
          </a>

          <a
            href="#about"
            class="text-[15px] font-semibold text-white transition-colors hover:text-[#FFC62F]"
          >
            ABOUT
          </a>

          <a
            href="#contact"
            class="rounded-full bg-[#FFC62F] px-7 py-3 text-[14px] font-bold text-[#16212B] transition-all hover:bg-[#FFD85C] hover:scale-[1.03]"
          >
            CONTACT
          </a>
        </nav>
-->


        <!-- Mobile menu -->
		 <!-- 
        <button
          type="button"
          class="flex h-11 w-11 items-center justify-center rounded-full border border-white/30 text-white lg:hidden"
          aria-label="Open navigation"
        >
          <div class="space-y-1.5">
            <span class="block h-[2px] w-5 bg-white"></span>
            <span class="block h-[2px] w-5 bg-white"></span>
            <span class="block h-[2px] w-5 bg-white"></span>
          </div>
        </button>

      </div>
    </header>-->

	<!-- =======================================================
     NAVIGATION (REACT ISLAND)
     ======================================================= -->

	<Navbar client:load />

	
	

    <!-- =======================================================
         HERO CONTENT
         ======================================================= -->
    <div class="relative z-10 mx-auto flex min-h-[calc(100vh-66px)] max-w-[1440px] items-center px-6 pb-24 pt-28 lg:px-16 pointer-events-none">

      <div class="max-w-[760px] pointer-events-auto">

        <h1
          class="max-w-[730px] text-[48px] font-extrabold leading-[1.02] tracking-[-0.035em] text-white sm:text-[58px] md:text-[68px] lg:text-[72px]"
        >
          Safer, smarter
          <br />

          inspections with
          <br />

          <span class="text-[#FFC62F]">
            powerful aerial data
          </span>
        </h1>

        <!-- Yellow line -->
        <div class="mt-7 h-[3px] w-[470px] max-w-full bg-[#FFC62F]"></div>

        <p
          class="mt-6 max-w-[690px] text-[17px] leading-[1.7] text-white/90 md:text-[18px]"
        >
          Transform how you inspect and manage your assets. Rishika Infra pairs
          expert drone inspection services with powerful aerial data management
          to provide rapid, reliable insight across industries. The result:
          reduced downtime, enhanced safety, and smarter decisions.
        </p>

        <div class="mt-9">
          <a
            href="#contact"
            class="inline-flex items-center justify-center rounded-full bg-[#FFC62F] px-9 py-4 text-[15px] font-bold text-[#17212B] transition-all hover:bg-[#FFD85C] hover:shadow-xl hover:-translate-y-0.5"
          >
            Get in touch
          </a>
        </div>
      </div>
    </div>


    <!-- =======================================================
         SCROLL INDICATOR
         ======================================================= -->
    <a
      href="#sectors"
      class="absolute bottom-5 left-1/2 z-20 flex -translate-x-1/2 flex-col items-center text-white"
      aria-label="Scroll down"
    >
      <div
        class="flex h-16 w-16 items-center justify-center rounded-full border border-[#FFC62F] bg-black/10 backdrop-blur-sm transition-colors hover:bg-[#FFC62F] hover:text-[#17212B]"
      >
        <svg
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          class="text-current"
        >
          <path
            d="M6 9L12 15L18 9"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </div>
    </a>

  </section>


  <!-- =========================================================
       CLIENTS
       ========================================================= -->
  <!-- <section class="border-b border-gray-200 bg-white py-10">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-16">

      <div class="flex flex-wrap items-center justify-center gap-x-14 gap-y-8 opacity-65 grayscale">
        {
          SITE_CONFIG.clients.map((client) => (
            <div class="whitespace-nowrap text-base font-bold tracking-wide text-gray-700">
              {client.name}
            </div>
          ))
        }
      </div>

    </div>
  </section>
  -->

  <!-- =========================================================
       CLIENTS (INTERACTIVE CAROUSEL)
       ========================================================= -->
  <section class="bg-white">
    <ClientCarousel client:load />
  </section>


  <!-- =========================================================
       WHO WE ARE
       ========================================================= -->
  <section id="about" class="bg-white py-24">
    <div class="mx-auto max-w-4xl px-6 text-center">

      <p class="text-sm font-bold uppercase tracking-[0.25em] text-gray-500">
        WHO WE ARE
      </p>

      <h2 class="mt-5 text-4xl font-bold tracking-tight text-[#17212B] md:text-5xl">
        Trusted leader in drone inspections
        and aerial data management
      </h2>

      <p class="mt-7 text-lg leading-8 text-gray-600">
        Rishika Infra transforms the way asset-intensive industries inspect,
        manage, and maintain critical infrastructure. We combine specialist
        pilots, advanced drone technology, and RTK/PPK systems to deliver safe,
        actionable insights that reduce risk and improve performance.
      </p>

      <div class="mt-10 flex flex-wrap justify-center gap-4">

        <a
          href="#inspections"
          class="rounded-full border-2 border-[#FFC62F] px-7 py-3 text-sm font-bold text-[#17212B] transition-colors hover:bg-[#FFC62F]"
        >
          Drone inspections
        </a>

        <a
          href="#data"
          class="rounded-full border-2 border-[#FFC62F] px-7 py-3 text-sm font-bold text-[#17212B] transition-colors hover:bg-[#FFC62F]"
        >
          Geospatial Mapping
        </a>

      </div>

    </div>
  </section>


  <!-- =========================================================
       SECTORS
       ========================================================= -->
  <section id="sectors" class="bg-white pb-24">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-16">

      <div class="mb-12 flex items-end justify-between">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.25em] text-gray-500">
            INDUSTRIES
          </p>

          <h2 class="mt-3 text-4xl font-bold text-[#17212B]">
            Sectors we serve
          </h2>
        </div>
      </div>


    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">

        <!-- Card 1: Power Grid & Utilities -->
        <a
          href="#"
          class="group relative h-[340px] overflow-hidden rounded-xl bg-[#24313C] transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.5)]"
        >
          <!-- Background Image (Verified Link) -->
          <img 
            src="public\images\cards\powergrid.png" 
            alt="Power Grid Transmission Towers"
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
          />

          <!-- Dark Gradient Overlay for text legibility -->
          <div class="absolute inset-0 bg-gradient-to-t from-[#101820] via-[#101820]/60 to-transparent"></div>

          <!-- Card Content -->
          <div class="absolute bottom-0 left-0 right-0 p-7">
            <div class="mb-3 text-sm font-semibold uppercase tracking-widest text-[#FFC62F]">
              SECTOR 01
            </div>

            <h3 class="text-2xl font-bold text-white leading-snug">
              Power Grid &
              <br />
              Utilities
            </h3>

            <div class="mt-5 flex h-9 w-9 items-center justify-center rounded-full bg-white text-[#17212B] transition-all duration-300 group-hover:translate-x-1 group-hover:bg-[#FFC62F]">
              →
            </div>
          </div>
        </a>


        <!-- Card 2: Renewables & Solar -->
        <a
          href="#"
          class="group relative h-[340px] overflow-hidden rounded-xl bg-[#24313C] transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.5)]"
        >
          <!-- Background Image (Zooms on hover) -->
          <img 
            src="https://images.unsplash.com/photo-1509391366360-2e959784a276?q=80&w=800&auto=format&fit=crop" 
            alt="Solar Panels"
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
          />

          <div class="absolute inset-0 bg-gradient-to-t from-[#101820] via-[#101820]/60 to-transparent"></div>

          <div class="absolute bottom-0 left-0 right-0 p-7">
            <div class="mb-3 text-sm font-semibold uppercase tracking-widest text-[#FFC62F]">
              SECTOR 02
            </div>

            <h3 class="text-2xl font-bold text-white leading-snug">
              Renewables &
              <br />
              Solar
            </h3>

            <div class="mt-5 flex h-9 w-9 items-center justify-center rounded-full bg-white text-[#17212B] transition-all duration-300 group-hover:translate-x-1 group-hover:bg-[#FFC62F]">
              →
            </div>
          </div>
        </a>


        <!-- Card 3: Capital Projects & Infrastructure -->
        <a
          href="#"
          class="group relative h-[340px] overflow-hidden rounded-xl bg-[#24313C] transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.5)]"
        >
          <!-- Background Image (Verified Link) -->
          <img 
            src="public\images\cards\construction.jpg" 
            alt="Construction Infrastructure"
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
          />

          <div class="absolute inset-0 bg-gradient-to-t from-[#101820] via-[#101820]/60 to-transparent"></div>

          <div class="absolute bottom-0 left-0 right-0 p-7">
            <div class="mb-3 text-sm font-semibold uppercase tracking-widest text-[#FFC62F]">
              SECTOR 03
            </div>

            <h3 class="text-2xl font-bold text-white leading-snug">
              Capital Projects &
              <br />
              Infrastructure
            </h3>

            <div class="mt-5 flex h-9 w-9 items-center justify-center rounded-full bg-white text-[#17212B] transition-all duration-300 group-hover:translate-x-1 group-hover:bg-[#FFC62F]">
              →
            </div>
          </div>
        </a>


        <!-- Card 4: Highway Corridor Mapping -->
        <a
          href="#"
          class="group relative h-[340px] overflow-hidden rounded-xl bg-[#24313C] transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.5)]"
        >
          <!-- Background Image (Zooms on hover) -->
          <img 
            src="public\images\cards\highway.jpg" 
            alt="Highway Corridor"
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
          />

          <div class="absolute inset-0 bg-gradient-to-t from-[#101820] via-[#101820]/60 to-transparent"></div>

          <div class="absolute bottom-0 left-0 right-0 p-7">
            <div class="mb-3 text-sm font-semibold uppercase tracking-widest text-[#FFC62F]">
              SECTOR 04
            </div>

            <h3 class="text-2xl font-bold text-white leading-snug">
              Highway Corridor
              <br />
              Mapping
            </h3>

            <div class="mt-5 flex h-9 w-9 items-center justify-center rounded-full bg-white text-[#17212B] transition-all duration-300 group-hover:translate-x-1 group-hover:bg-[#FFC62F]">
              →
            </div>
          </div>
        </a>

      </div>
    </div>
  </section>


  <!-- =========================================================
       SOLUTIONS
       ========================================================= -->
  <section id="solutions" class="bg-white py-24">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-16">

      <div class="mx-auto mb-14 max-w-3xl text-center">
        <p class="text-sm font-bold uppercase tracking-[0.25em] text-gray-500">
          WHAT WE DO
        </p>

        <h2 class="mt-4 text-4xl font-bold text-[#17212B] md:text-5xl">
          Our solutions
        </h2>

        <p class="mt-5 text-lg leading-8 text-gray-600">
          From flight to insight, Rishika Infra delivers precise,
          actionable intelligence across industrial assets.
        </p>
      </div>


      <div class="flex flex-wrap justify-center gap-5">

        {
          [
            'Inspections',
            'Thermal Diagnostics',
            'Geospatial Surveys',
            '3D Modeling (BIM)',
            'AI Traffic Mgmt'
          ].map((solution) => (
            <div class="skew-card flex h-36 w-60 items-center justify-center bg-[#FFC62F] shadow-sm transition-transform hover:-translate-y-1">
              <div class="skew-content px-5 text-center">
                <h3 class="text-sm font-bold uppercase tracking-wider text-[#17212B]">
                  {solution}
                </h3>
              </div>
            </div>
          ))
        }

      </div>
    </div>
  </section>

  <!-- =========================================================
       DIFFERENTIATORS (WHY RISHIKA)
       ========================================================= -->
  <section id="differentiators" class="bg-white py-24 border-t border-gray-100">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-16">
      
      <!-- Section Header -->
      <div class="mb-16 text-center md:text-left flex flex-col md:flex-row md:items-end justify-between border-b border-gray-200 pb-8">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.25em] text-[#0070BA] mb-2">
            WHY RISHIKA INFRA?
          </p>
          <h2 class="text-3xl md:text-4xl font-bold text-[#17212B]">
            Our Differentiators
          </h2>
        </div>
      </div>

      <!-- 4-Column Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-12">
        
        <!-- Feature 1: Enhanced Safety -->
        <div class="group cursor-pointer">
          <div class="flex items-center gap-4 mb-4">
            <div class="relative flex h-12 w-12 items-center justify-center rounded-full border-2 border-[#FFC62F] text-[#FFC62F] transition-transform duration-300 group-hover:scale-110 group-hover:bg-[#FFC62F] group-hover:text-white">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-[#17212B]">Enhanced Safety</h3>
          </div>
          <p class="text-[15px] leading-relaxed text-gray-600">
            Drone inspections eliminate the need for personnel to climb towers, enter hazardous environments, or work near energized equipment[cite: 1].
          </p>
        </div>

        <!-- Feature 2: Advanced Technology -->
        <div class="group cursor-pointer">
          <div class="flex items-center gap-4 mb-4">
            <div class="relative flex h-12 w-12 items-center justify-center rounded-full border-2 border-[#FFC62F] text-[#FFC62F] transition-transform duration-300 group-hover:scale-110 group-hover:bg-[#FFC62F] group-hover:text-white">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-[#17212B]">Advanced Technology</h3>
          </div>
          <p class="text-[15px] leading-relaxed text-gray-600">
            We utilize modern UAV platforms equipped with visual and thermal sensors to deliver reliable, high-fidelity data at every asset[cite: 1].
          </p>
        </div>

        <!-- Feature 3: Cost Efficiency -->
        <div class="group cursor-pointer">
          <div class="flex items-center gap-4 mb-4">
            <div class="relative flex h-12 w-12 items-center justify-center rounded-full border-2 border-[#FFC62F] text-[#FFC62F] transition-transform duration-300 group-hover:scale-110 group-hover:bg-[#FFC62F] group-hover:text-white">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-[#17212B]">Cost Efficiency</h3>
          </div>
          <p class="text-[15px] leading-relaxed text-gray-600">
            Our solutions significantly reduce inspection time, manpower requirements, and operational costs while ensuring fast project delivery[cite: 1].
          </p>
        </div>

        <!-- Feature 4: Improved Accuracy -->
        <div class="group cursor-pointer">
          <div class="flex items-center gap-4 mb-4">
            <div class="relative flex h-12 w-12 items-center justify-center rounded-full border-2 border-[#FFC62F] text-[#FFC62F] transition-transform duration-300 group-hover:scale-110 group-hover:bg-[#FFC62F] group-hover:text-white">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <circle cx="12" cy="12" r="4"/>
                <line x1="21.17" y1="8" x2="12" y2="8"/>
                <line x1="3.95" y1="6.06" x2="8.54" y2="14"/>
                <line x1="10.88" y1="21.94" x2="15.46" y2="14"/>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-[#17212B]">Improved Accuracy</h3>
          </div>
          <p class="text-[15px] leading-relaxed text-gray-600">
            High-resolution imaging and thermal sensors enable precise defect identification, turning complex challenges into clear, actionable insight[cite: 1].
          </p>
        </div>

      </div>
    </div>
  </section>


  <!-- =========================================================
       CTA
       ========================================================= -->
  <section id="contact" class="bg-[#17212B] py-24">
    <div class="mx-auto max-w-5xl px-6 text-center">

      <p class="text-sm font-bold uppercase tracking-[0.25em] text-[#FFC62F]">
        READY TO GET STARTED?
      </p>

      <h2 class="mt-5 text-4xl font-bold text-white md:text-5xl">
        Make your asset inspections
        safer and smarter.
      </h2>

      <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-white/70">
        Talk to our team about drone inspection, aerial data,
        mapping and geospatial intelligence.
      </p>

      <div class="mt-9">
        <a
