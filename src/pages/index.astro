---
import Layout from "../layouts/Layout.astro";
import { SITE_CONFIG } from "../data/siteConfig";
import ClientCarousel from "../components/islands/ClientCarousel";
import Navbar from "../components/islands/Navbar";
import SolutionsGrid from "../components/shared/SolutionsGrid.astro";
import FleetAndEquipment from "../components/shared/FleetAndEquipment.astro";
import RishikaAI from "../components/shared/RishikaAI.astro";
import Differentiators from "../components/shared/Differentiators.astro";
import NewsSlider from "../components/islands/NewsSlider";
---

<Layout title="Rishika Infra | Aerial Inspection & GIS">
  <!-- =========================================================
       TOP ANNOUNCEMENT BAR
       ========================================================= -->
  <div class="relative z-[60] h-[66px] overflow-hidden bg-white">
    <div
      class="mx-auto flex h-full max-w-[1440px] items-center justify-between px-6 lg:px-16"
    >
      <!-- Left -->
      <div class="flex items-center gap-6">
        <div class="flex items-center gap-3">
          <span class="text-[22px] font-medium tracking-[0.2em] text-[#17324D]">
          </span>

          <span class="text-2xl text-[#0077B8]">✦</span>
        </div>

        <div class="hidden h-8 w-px bg-gray-300 md:block"></div>

        <p class="text-sm text-[#1F2937] md:text-[15px]">
          <span class="font-bold">Rishika Infra</span>
          is a leader in aerial inspection and geospatial intelligence.
          <a
            href="#about"
            class="ml-1 font-semibold underline underline-offset-2 transition-colors hover:text-[#0070BA]"
          >
            Read more
          </a>
        </p>
      </div>

      <!-- Right -->
      <div
        class="hidden items-center gap-8 text-sm font-bold text-[#0070BA] md:flex"
      >
        <a href="#contact" class="transition-colors hover:text-[#17324D]">
          CONTACT US
        </a>

        <a
          href="#demo"
          class="rounded-full bg-[#F7F7F7] px-7 py-3 text-[#111827] transition-all hover:bg-[#E5E7EB]"
        >
          BOOK A DEMO
        </a>
      </div>
    </div>

    <!-- Diagonal blue strip -->
    <div
      class="absolute right-0 top-0 h-full w-[28%] opacity-95"
      style="
        background:
          repeating-linear-gradient(
            55deg,
            #FFFFFF 0px,
            #FFFFFF 26px,
            #0077B8 26px,
            #0077B8 56px
          );
        clip-path: polygon(18% 0, 100% 0, 100% 100%, 0 100%);
      "
    >
    </div>

    <!-- Keep controls above stripe -->
    <div class="pointer-events-none absolute inset-0"></div>
  </div>

  <!-- =========================================================
       HERO
       ========================================================= -->
  <section
    class="relative min-h-[calc(100vh-66px)] overflow-hidden bg-[#1D2630]"
  >
    <!-- Background video -->
    <video
      class="absolute inset-0 h-full w-full object-cover"
      autoplay
      muted
      loop
      playsinline
      poster="/images/cyberhawk-hero-poster.g"
      aria-hidden="true"
    >
      <source src="videos/WebsiteVideo.mp4" type="video/mp4" />
    </video>

    <!-- Dark overlay -->
    <div class="absolute inset-0 bg-[#17212B]/45 pointer-events-none"></div>

    <!-- Strong left-side gradient -->
    <div
      class="absolute inset-0 pointer-events-none"
      style="
        background:
          linear-gradient(
            90deg,
            rgba(20, 29, 38, 0.96) 0%,
            rgba(20, 29, 38, 0.85) 29%,
            rgba(20, 29, 38, 0.48) 55%,
            rgba(20, 29, 38, 0.08) 100%
          );
      "
    >
    </div>

    <!-- Slight blue tint on the right -->
    <div
      class="absolute inset-0 pointer-events-none"
      style="
        background:
          linear-gradient(
            180deg,
            rgba(6, 24, 38, 0.15) 0%,
            rgba(0, 112, 186, 0.08) 100%
          );
      "
    >
    </div>

   

    <!-- =======================================================
     NAVIGATION (REACT ISLAND)
     ======================================================= -->

    <Navbar client:load />

    <!-- =======================================================
         HERO CONTENT
         ======================================================= -->
    <div
      class="relative z-10 mx-auto flex min-h-[calc(100vh-66px)] max-w-[1440px] items-center px-6 pb-24 pt-28 lg:px-16 pointer-events-none"
    >
      <div class="max-w-[760px] pointer-events-auto">
        <h1
          class="max-w-[730px] text-[48px] font-extrabold leading-[1.02] tracking-[-0.035em] text-white sm:text-[58px] md:text-[68px] lg:text-[72px]"
        >
          Safer, smarter
          <br />

          inspections with
          <br />

          <span class="text-[#FFC62F]"> powerful aerial data </span>
        </h1>

        <!-- Yellow line -->
        <div class="mt-7 h-[3px] w-[470px] max-w-full bg-[#FFC62F]"></div>

        <p
          class="mt-6 max-w-[690px] text-[17px] leading-[1.7] text-white/90 md:text-[18px]"
        >
          Transform how you inspect and manage your assets. Rishika Infra pairs
          expert drone inspection services with powerful aerial data management
          to provide rapid, reliable insight across industries. The result:
          reduced downtime, enhanced safety, and smarter decisions.
        </p>

        <div class="mt-9">
          <a
            href="#contact"
            class="inline-flex items-center justify-center rounded-full bg-[#FFC62F] px-9 py-4 text-[15px] font-bold text-[#17212B] transition-all hover:bg-[#FFD85C] hover:shadow-xl hover:-translate-y-0.5"
          >
            Get in touch
          </a>
        </div>
      </div>
    </div>

    <!-- =======================================================
         SCROLL INDICATOR
         ======================================================= -->
    <a
      href="#sectors"
      class="absolute bottom-5 left-1/2 z-20 flex -translate-x-1/2 flex-col items-center text-white"
      aria-label="Scroll down"
    >
      <div
        class="flex h-16 w-16 items-center justify-center rounded-full border border-[#FFC62F] bg-black/10 backdrop-blur-sm transition-colors hover:bg-[#FFC62F] hover:text-[#17212B]"
      >
        <svg
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          class="text-current"
        >
          <path
            d="M6 9L12 15L18 9"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </div>
    </a>
  </section>

  <!-- =========================================================
       CLIENTS
       ========================================================= -->
  <!-- <section class="border-b border-gray-200 bg-white py-10">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-16">

      <div class="flex flex-wrap items-center justify-center gap-x-14 gap-y-8 opacity-65 grayscale">
        {
          SITE_CONFIG.clients.map((client) => (
            <div class="whitespace-nowrap text-base font-bold tracking-wide text-gray-700">
              {client.name}
            </div>
          ))
        }
      </div>

    </div>
  </section>
  -->

  <!-- =========================================================
       CLIENTS (INTERACTIVE CAROUSEL)
       ========================================================= -->
  <section class="bg-white">
    <ClientCarousel client:load />
  </section>

  <!-- =========================================================
       WHO WE ARE
       ========================================================= -->
  <section id="about" class="bg-white py-24">
    <div class="mx-auto max-w-4xl px-6 text-center">
      <p class="text-sm font-bold uppercase tracking-[0.25em] text-gray-500">
        WHO WE ARE
      </p>

      <h2
        class="mt-5 text-4xl font-bold tracking-tight text-[#17212B] md:text-5xl"
      >
        Trusted leader in drone inspections and aerial data management
      </h2>

      <p class="mt-7 text-lg leading-8 text-gray-600">
        Rishika Infra transforms the way asset-intensive industries inspect,
        manage, and maintain critical infrastructure. We combine specialist
        pilots, advanced drone technology, and RTK/PPK systems to deliver safe,
        actionable insights that reduce risk and improve performance.
      </p>

      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a
          href="#inspections"
          class="rounded-full border-2 border-[#FFC62F] px-7 py-3 text-sm font-bold text-[#17212B] transition-colors hover:bg-[#FFC62F]"
        >
          Drone inspections
        </a>

        <a
          href="#data"
          class="rounded-full border-2 border-[#FFC62F] px-7 py-3 text-sm font-bold text-[#17212B] transition-colors hover:bg-[#FFC62F]"
        >
          Geospatial Mapping
        </a>
      </div>
    </div>
  </section>

  <!-- =========================================================
       SOLUTIONS
       ========================================================= -->

  <SolutionsGrid />

  <FleetAndEquipment />

  <RishikaAI />

  <!-- =========================================================
       DIFFERENTIATORS (WHY RISHIKA)
       ========================================================= -->
  
      <Differentiators />

      <NewsSlider />

  

  <!-- =========================================================
       LOCAL STYLES
       ========================================================= -->
  <style>
    .skew-card {
      transform: skewX(-8deg);
    }

    .skew-content {
      transform: skewX(8deg);
    }
  </style>
</Layout>
