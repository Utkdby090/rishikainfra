---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/islands/Navbar';
import NewsSlider from '../components/islands/NewsSlider';
---

<Layout title="News & Updates | Rishika Infra">
  <Navbar client:load />

  <section class="pt-32 pb-12 bg-white">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-16 text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold text-[#17212B] mb-6">
        Company News
      </h1>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Stay up to date with the latest projects, technology rollouts, and regulatory approvals from the Rishika Infra team.
      </p>
    </div>
  </section>

  {/* Reusing your awesome React Slider here */}
  <NewsSlider client:visible />

</Layout>