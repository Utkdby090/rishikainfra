---
import Img from '../../components/shared/Img.astro';
import Layout from '../../layouts/Layout.astro';
import { NEWS } from '../../data/news';

const [featuredNews, ...allNews] = NEWS;
---

<Layout description="News from Rishika Infra: projects, technology rollouts and regulatory approvals in drone inspection and geospatial mapping." title="Company News | Rishika Infra" hideCTA={true}>

  <!-- =========================================================
       HERO SECTION (Dark Theme to fix Navbar Contrast)
       ========================================================= -->
  <section class="relative min-h-screen flex items-center justify-center pt-20 overflow-hidden bg-brand-ink">
    {/* Subtle Corporate/Tech Background Image */}
    <Img fetchpriority="high" 
      src="https://images.unsplash.com/photo-1497366216548-37526070297c?q=80&w=2500&auto=format&fit=crop" 
      class="absolute inset-0 h-full w-full object-cover opacity-20" 
      alt="Corporate News Background" 
    />
    
    <div class="absolute inset-0 bg-gradient-to-b from-brand-ink/90 via-brand-ink/70 to-brand-ink"></div>
    
    <div class="relative z-10 mx-auto max-w-[1440px] px-6 lg:px-16 w-full flex flex-col items-center text-center">
      <div class="max-w-[900px] repeat-animate" data-transform="translateY(30px)">
        <h1 class="text-[42px] font-extrabold leading-[1.1] tracking-tight text-white md:text-[56px] lg:text-[64px] mb-6">
          Company News
        </h1>
        <p class="text-[17px] md:text-[19px] leading-relaxed text-white/80 mx-auto max-w-[700px]">
          Stay up to date with the latest projects, technology rollouts, and regulatory approvals from the Rishika Infra team.
        </p>
      </div>
    </div>
    
    <!-- Scroll Down Arrow Indicator (White/Yellow for dark bg) -->
    <a
      href="#news-content"
      class="absolute bottom-8 left-1/2 z-20 flex -translate-x-1/2 flex-col items-center text-white"
      aria-label="Scroll down"
    >
      <div class="flex h-14 w-14 items-center justify-center rounded-full border border-brand-yellow bg-black/10 backdrop-blur-sm transition-colors hover:bg-brand-yellow hover:text-brand-ink">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-current">
          <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </div>
    </a>
  </section>

  <!-- =========================================================
       MAIN NEWS CONTENT
       ========================================================= -->
  <section id="news-content" class="bg-gray-50 py-24 border-t border-gray-200">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-16">
      
      <!-- =========================================================
           FEATURED NEWS HEADER
           ========================================================= -->
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden mb-16 relative flex flex-col md:flex-row">
        
        <!-- Diagonal Yellow Stripes (Top Right Decor) -->
        <div class="hidden md:block absolute top-0 right-0 w-24 h-24 overflow-hidden pointer-events-none z-10">
          <div class="absolute -top-12 -right-12 w-48 h-12 rotate-45" style="background: repeating-linear-gradient(45deg, #FFC62F, #FFC62F 15px, #17212B 15px, #17212B 30px);"></div>
        </div>

        <!-- Image Side -->
        <div class="w-full md:w-1/2 lg:w-[45%] h-72 md:h-auto relative">
          <Img loading="lazy" decoding="async" src={featuredNews.img} alt={featuredNews.title} class="w-full h-full object-cover" />
          <!-- Floating Yellow Badge -->
          <div class="absolute bottom-6 left-6 bg-brand-yellow text-brand-ink text-[11px] font-bold px-4 py-2 rounded-md uppercase tracking-widest shadow-md">
            News Insight
          </div>
        </div>

        <!-- Text Side -->
        <div class="w-full md:w-1/2 lg:w-[55%] p-8 md:p-12 lg:p-16 flex flex-col justify-center bg-white">
          <h2 class="text-3xl md:text-4xl lg:text-[40px] font-bold text-brand-ink leading-[1.1] mb-6 tracking-tight">
            {featuredNews.title}
          </h2>
          <p class="text-gray-600 text-lg mb-10 leading-relaxed max-w-xl">
            {featuredNews.excerpt}
          </p>
          <div>
            <a href={`/news/${featuredNews.slug}`} class="inline-flex rounded-full border-2 border-gray-200 px-8 py-3 text-sm font-bold text-brand-ink hover:border-brand-ink transition-colors">
              Learn more
            </a>
          </div>
        </div>
      </div>

      <!-- =========================================================
           LAYOUT: SIDEBAR & MAIN GRID
           ========================================================= -->
      <div class="flex flex-col lg:flex-row gap-12 lg:gap-16">
        
        <!-- Left Sidebar -->
        <aside class="w-full lg:w-1/4 flex flex-col gap-6">
          <h2 class="text-[32px] font-light text-brand-ink leading-tight">
            Latest <span class="font-bold">news</span>
          </h2>
          <p class="text-sm text-gray-600 leading-relaxed pr-4">
            Rishika Infra has teams operating in over 40 countries around the world. Get the latest news on our team's achievements.
          </p>
          
          <!-- Search Bar -->
          <form role="search" class="relative mt-2" data-news-search>
            <label for="news-search" class="sr-only">Search news</label>
            <input 
              id="news-search"
              type="search" 
              placeholder="Search" 
              class="w-full border border-gray-300 rounded-md py-3 pl-4 pr-10 focus:outline-none focus:border-brand-blue focus:ring-1 focus:ring-brand-blue transition-colors bg-white"
            />
            <button type="submit" aria-label="Search news" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-brand-ink">
              <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
            </button>
          </form>
        </aside>

        <!-- Right Grid -->
        <div class="w-full lg:w-3/4">
          <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">
            {allNews.map((article) => (
              <div 
                class="news-card bg-white rounded-xl shadow-[0_2px_10px_rgba(0,0,0,0.04)] border border-gray-100 overflow-hidden flex flex-col group hover:shadow-xl transition-all duration-300"
                data-title={article.title.toLowerCase()}
              >
                <div class="h-48 overflow-hidden bg-gray-200">
                  <Img loading="lazy" decoding="async" src={article.img.replace('w=1200', 'w=600')} alt={article.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out" />
                </div>
                <div class="p-7 flex flex-col flex-grow">
                  <h3 class="font-bold text-[19px] text-brand-ink mb-3 leading-snug group-hover:text-brand-blue transition-colors">
                    {article.title}
                  </h3>
                  <p class="text-[15px] text-gray-600 mb-8 line-clamp-3 leading-relaxed">
                    {article.excerpt}
                  </p>
                  <div class="mt-auto">
                    <a href={`/news/${article.slug}`} class="inline-flex rounded-full border-2 border-gray-100 px-6 py-2.5 text-sm font-bold text-brand-ink group-hover:border-brand-ink transition-colors">
                      Learn more
                    </a>
                  </div>
                </div>
              </div>
            ))}
          </div>
          
          <p data-news-empty hidden class="mt-8 text-gray-600" role="status">No news matches your search.</p>
        </div>

      </div>
    </div>
  </section>

  <script>
    // Filter the news cards by title as the visitor types
    const form = document.querySelector<HTMLFormElement>('[data-news-search]');
    const input = form?.querySelector<HTMLInputElement>('input');
    const cards = [...document.querySelectorAll<HTMLElement>('.news-card')];
    const empty = document.querySelector<HTMLElement>('[data-news-empty]');
    const filter = () => {
      const query = (input?.value ?? '').trim().toLowerCase();
      let shown = 0;
      for (const card of cards) {
        const match = !query || (card.dataset.title ?? '').includes(query);
        card.hidden = !match;
        if (match) shown++;
      }
      if (empty) empty.hidden = shown > 0;
    };
    input?.addEventListener('input', filter);
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      filter();
    });
  </script>

  <style>
    html {
      scroll-behavior: smooth;
    }
  </style>
</Layout>