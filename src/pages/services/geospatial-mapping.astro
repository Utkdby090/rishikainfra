---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/islands/Navbar';
import SolutionsGrid from '../../components/shared/SolutionsGrid.astro';
import Differentiators from '../../components/shared/Differentiators.astro';
import NewsSlider from '../../components/islands/NewsSlider';
---

<Layout title="Geospatial Mapping & LiDAR | Rishika Infra">
  <Navbar client:load />

  <!-- =========================================================
       HERO 
       ========================================================= -->
  <section class="relative min-h-[70vh] flex items-center pt-20 overflow-hidden bg-[#1D2630]">
    <img src="https://images.unsplash.com/photo-1545042746-ec9e5a59b359?q=80&w=2500&auto=format&fit=crop" class="absolute inset-0 h-full w-full object-cover opacity-50" alt="Highway Corridor Mapping" />
    <div class="absolute inset-0 bg-gradient-to-r from-[#17212B] via-[#17212B]/80 to-transparent"></div>
    
    <div class="relative z-10 mx-auto max-w-[1440px] px-6 lg:px-16 w-full">
      <div class="max-w-[760px]">
        <h1 class="text-[42px] font-extrabold leading-[1.05] tracking-tight text-white md:text-[56px]">
          Precision engineering mapping<br/>
          <span class="text-[#FFC62F]">powered by LiDAR</span>
        </h1>
        <p class="mt-6 max-w-[600px] text-[17px] leading-relaxed text-white/90">
          Our advanced drone mapping solutions provide accurate geospatial information for engineering and planning projects[cite: 1]. We provide end-to-end 3D mapping and modeling of large areas using UAVs, aerial platforms, LiDAR, and photogrammetry[cite: 2].
        </p>
        <div class="mt-8">
          <a href="#contact" class="inline-flex rounded-full bg-[#FFC62F] px-8 py-3.5 font-bold text-[#17212B] transition-all hover:bg-[#FFD85C]">
            Get in touch
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       INTRO SECTION (Image Right)
       ========================================================= -->
  <section class="bg-white py-24">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-16 grid lg:grid-cols-2 gap-16 items-center">
      <div>
        <h2 class="text-3xl md:text-4xl font-bold text-[#17212B] mb-6">Replace long, costly, and<br/><span class="text-gray-400">hazardous manual surveys</span></h2>
        <p class="text-lg text-gray-600 leading-relaxed mb-6">
          Drones equipped with high-resolution cameras and LiDAR sensors can quickly scan large areas[cite: 2]. Using RTK/PPK & GCP-based georeferencing, we guarantee high accuracy and completeness for corridors, cities, mining leases, and industrial zones[cite: 2].
        </p>
        <p class="text-lg text-gray-600 leading-relaxed">
          We process this raw flight data into accurate 2D maps and 3D terrain models of highway corridors[cite: 2], allowing your engineering teams to calculate earthwork volumes and monitor construction progress remotely[cite: 1].
        </p>
      </div>
      <div class="relative">
        <img src="https://images.unsplash.com/photo-1541888086425-d81bb19240f5?q=80&w=800&auto=format&fit=crop" alt="Digital Elevation Modeling" class="rounded-xl shadow-2xl" />
        <div class="absolute -bottom-6 -left-6 w-24 h-24 bg-gray-100 rounded-full border-[8px] border-white flex items-center justify-center">
          <span class="text-[#FFC62F] text-2xl font-bold">🗺️</span>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       CAPABILITIES DIAGRAM
       ========================================================= -->
  <section class="bg-gray-50 py-20 border-y border-gray-200">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-16">
      <div class="flex justify-center mb-12">
        <div class="w-px h-16 bg-gray-300"></div>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
        <div class="bg-white p-6 rounded shadow-sm border-t-4 border-[#FFC62F] hover:-translate-y-1 transition-transform cursor-pointer">
          <div class="text-3xl mb-3">📐</div>
          <h4 class="font-bold text-[#17212B] text-sm">Digital Elevation Models</h4>
          <p class="text-xs text-gray-500 mt-2">Generate precise DTM and DSM[cite: 1]</p>
        </div>
        <div class="bg-white p-6 rounded shadow-sm border-t-4 border-gray-200 hover:border-[#FFC62F] hover:-translate-y-1 transition-all cursor-pointer">
          <div class="text-3xl mb-3">🌍</div>
          <h4 class="font-bold text-[#17212B] text-sm">Orthomosaic Mapping</h4>
          <p class="text-xs text-gray-500 mt-2">High-resolution 2D stitching[cite: 1]</p>
        </div>
        <div class="bg-white p-6 rounded shadow-sm border-t-4 border-gray-200 hover:border-[#FFC62F] hover:-translate-y-1 transition-all cursor-pointer">
          <div class="text-3xl mb-3">🛣️</div>
          <h4 class="font-bold text-[#17212B] text-sm">Corridor Mapping</h4>
          <p class="text-xs text-gray-500 mt-2">Highway & railway (NHAI) planning[cite: 1, 2]</p>
        </div>
        <div class="bg-white p-6 rounded shadow-sm border-t-4 border-gray-200 hover:border-[#FFC62F] hover:-translate-y-1 transition-all cursor-pointer">
          <div class="text-3xl mb-3">🧊</div>
          <h4 class="font-bold text-[#17212B] text-sm">3D Terrain Modelling</h4>
          <p class="text-xs text-gray-500 mt-2">Earthwork & Stockpile Volume Calculation[cite: 1]</p>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       SHARED SECTIONS
       ========================================================= -->
  <SolutionsGrid />
  <Differentiators />
  <NewsSlider client:visible />

</Layout>