---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/islands/Navbar';
import FleetAndEquipment from '../../components/shared/FleetAndEquipment.astro';
---

<Layout title="Geospatial Mapping & LiDAR | Rishika Infra">
  <Navbar client:load />

  <!-- =========================================================
       HERO SECTION
       ========================================================= -->
  <section class="relative min-h-[85vh] flex items-center pt-20 overflow-hidden bg-[#1D2630]">
    <img 
      src="https://images.unsplash.com/photo-1524661135-423995f22d0b?q=80&w=2500&auto=format&fit=crop" 
      class="absolute inset-0 h-full w-full object-cover opacity-40 scale-105" 
      alt="Topographic Mapping" 
    />
    <div class="absolute inset-0 bg-gradient-to-r from-[#17212B] via-[#17212B]/80 to-transparent"></div>
    
    <div class="relative z-10 mx-auto max-w-[1440px] px-6 lg:px-16 w-full">
      <div class="max-w-[800px] repeat-animate" data-transform="translateY(30px)">
        <p class="text-[12px] font-bold uppercase tracking-[0.3em] text-[#FFC62F] mb-6">
          3D Terrain & Modeling
        </p>
        <h1 class="text-4xl md:text-6xl lg:text-[64px] font-extrabold leading-[1.05] tracking-tight text-white mb-8">
          Precision engineering mapping<br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#FFC62F] to-[#FFD85C]">powered by LiDAR.</span>
        </h1>
        <p class="text-lg md:text-xl leading-relaxed text-white/90 mb-10 max-w-2xl">
          End-to-end 3D mapping and modeling of large areas using UAVs, aerial platforms, LiDAR, and photogrammetry. Replace long, costly, and hazardous manual surveys with sub-centimeter accurate digital twins[cite: 2].
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/contact" class="inline-flex rounded-full bg-[#FFC62F] px-8 py-4 font-bold text-[#17212B] transition-all hover:bg-[#FFD85C] hover:-translate-y-1">
            Request a Survey
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       VALUE PROP: THE RISHIKA ADVANTAGE (Split layout)
       ========================================================= -->
  <section class="bg-white py-24 overflow-hidden">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-16 grid lg:grid-cols-2 gap-16 lg:gap-24 items-center">
      <div class="repeat-animate" data-transform="translateX(-40px)">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-[#17212B] mb-8 leading-tight">
          Capture reality with <br/><span class="text-[#0070BA]">absolute accuracy.</span>
        </h2>
        <p class="text-lg text-gray-600 leading-relaxed mb-6">
          Drones equipped with high-resolution cameras and LiDAR sensors can quickly scan large areas[cite: 2]. Using RTK/PPK & GCP-based georeferencing, we guarantee high accuracy and completeness for corridors, cities, mining leases, and industrial zones[cite: 2].
        </p>
        <p class="text-lg text-gray-600 leading-relaxed mb-8">
          This rich visual and spatial data empowers your engineering teams to calculate earthwork volumes and monitor construction progress remotely, reducing the need for manual site visits[cite: 1, 2].
        </p>
        <ul class="space-y-3 font-semibold text-[#17212B]">
          <li class="flex items-center gap-3"><span class="text-[#FFC62F] text-xl">✓</span> Faster surveys than traditional methods[cite: 2]</li>
          <li class="flex items-center gap-3"><span class="text-[#FFC62F] text-xl">✓</span> Higher accuracy and repeatability[cite: 2]</li>
          <li class="flex items-center gap-3"><span class="text-[#FFC62F] text-xl">✓</span> Integration of LiDAR and Photogrammetry[cite: 2]</li>
        </ul>
      </div>
      
      <div class="relative repeat-animate" data-transform="translateX(40px)">
        <div class="relative rounded-2xl overflow-hidden shadow-2xl">
          <img src="https://images.unsplash.com/photo-1541888086425-d81bb19240f5?q=80&w=1000&auto=format&fit=crop" alt="Digital Elevation Modeling" class="w-full h-auto object-cover hover:scale-105 transition-transform duration-700" />
        </div>
        <!-- Decorative Element -->
        <div class="absolute -bottom-10 -left-10 w-40 h-40 bg-[radial-gradient(#FFC62F_2px,transparent_2px)] [background-size:16px_16px] opacity-40 -z-10"></div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       DELIVERABLES GRID (Dark Theme)
       ========================================================= -->
  <section class="bg-[#17212B] py-24 overflow-hidden border-t border-white/10">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-16">
      <div class="text-center max-w-3xl mx-auto mb-20 repeat-animate" data-transform="translateY(30px)">
        <p class="text-sm font-bold uppercase tracking-[0.25em] text-[#FFC62F] mb-4">OUTPUT DATA</p>
        <h2 class="text-4xl font-bold text-white mb-6">Actionable Topographic Deliverables</h2>
        <p class="text-white/70 text-lg">We process raw flight data into industry-standard formats ready for immediate import into your CAD, BIM, and GIS software.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Deliverable 1 -->
        <div class="bg-[#24313C] p-8 rounded-xl border border-white/5 hover:border-[#FFC62F]/50 transition-colors group repeat-animate" data-transform="translateY(40px)">
          <div class="w-14 h-14 bg-[#17212B] rounded-lg flex items-center justify-center text-2xl mb-6 shadow-inner text-[#FFC62F] group-hover:scale-110 transition-transform">📐</div>
          <h3 class="text-xl font-bold text-white mb-3">Elevation Models</h3>
          <p class="text-white/60 text-sm leading-relaxed">Generate precise Digital Terrain Models (DTM) and Digital Surface Models (DSM) for accurate topographic analysis[cite: 1, 2].</p>
        </div>

        <!-- Deliverable 2 -->
        <div class="bg-[#24313C] p-8 rounded-xl border border-white/5 hover:border-[#FFC62F]/50 transition-colors group repeat-animate" data-transform="translateY(40px)">
          <div class="w-14 h-14 bg-[#17212B] rounded-lg flex items-center justify-center text-2xl mb-6 shadow-inner text-[#FFC62F] group-hover:scale-110 transition-transform">🌍</div>
          <h3 class="text-xl font-bold text-white mb-3">Orthomosaic Mapping</h3>
          <p class="text-white/60 text-sm leading-relaxed">High-resolution, distortion-free 2D map stitching used for land records, large-area asset mapping, and urban planning[cite: 1, 2].</p>
        </div>

        <!-- Deliverable 3 -->
        <div class="bg-[#24313C] p-8 rounded-xl border border-white/5 hover:border-[#FFC62F]/50 transition-colors group repeat-animate" data-transform="translateY(40px)">
          <div class="w-14 h-14 bg-[#17212B] rounded-lg flex items-center justify-center text-2xl mb-6 shadow-inner text-[#FFC62F] group-hover:scale-110 transition-transform">🛣️</div>
          <h3 class="text-xl font-bold text-white mb-3">Corridor Mapping</h3>
          <p class="text-white/60 text-sm leading-relaxed">Dedicated alignment surveys and ROW mapping for highway and railway corridors, supporting NHAI projects[cite: 1, 2].</p>
        </div>

        <!-- Deliverable 4 -->
        <div class="bg-[#24313C] p-8 rounded-xl border border-white/5 hover:border-[#FFC62F]/50 transition-colors group repeat-animate" data-transform="translateY(40px)">
          <div class="w-14 h-14 bg-[#17212B] rounded-lg flex items-center justify-center text-2xl mb-6 shadow-inner text-[#FFC62F] group-hover:scale-110 transition-transform">🧊</div>
          <h3 class="text-xl font-bold text-white mb-3">Volumetrics & 3D</h3>
          <p class="text-white/60 text-sm leading-relaxed">Earthwork and stockpile volume calculation alongside complete 3D terrain modeling for mining and construction[cite: 1, 2].</p>
        </div>

      </div>
    </div>
  </section>

  <!-- =========================================================
       HARDWARE COMPONENT (Injected)
       ========================================================= -->
  <FleetAndEquipment />

</Layout>