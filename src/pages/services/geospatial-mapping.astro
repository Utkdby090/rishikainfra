---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Differentiators from '../../components/shared/Differentiators.astro';
import AnimatedShowcase from '../../components/AnimatedShowcase.astro';
const applicationsData = [
  {
    id: 'highway',
    tabLabel: 'Highway & Rail',
    tagline: 'Comprehensive corridor mapping for infrastructure.',
    heading: 'Transportation Corridors',
    description: 'Rapid, high-accuracy alignment surveys for NHAI and railway infrastructure. We provide continuous topographical data to streamline planning, monitor construction progress, and maintain existing corridor assets without disrupting traffic.',
    image: '/images/our solutions/LidarEngineering/sectionimage/highwaymapping.jpg'
  },
  {
    id: 'mining',
    tabLabel: 'Mining Sector',
    tagline: 'Accurate mining planning & volume estimation.',
    heading: 'Earthworks & Mining',
    description: 'Optimize your operations with precise topographic data. Our drone surveys deliver highly accurate volumetric calculations for stockpiles, pit monitoring, and route planning, drastically reducing safety risks for ground personnel.',
    image: '/images/our solutions/LidarEngineering/sectionimage/earthworkmining.jpg'
  },
  {
    id: 'urban',
    tabLabel: 'Urban Planning',
    tagline: 'High-density urban topographical surveys.',
    heading: 'Smart City Development',
    description: 'Capture the built environment in stunning 3D detail. We provide urban planners and municipal bodies with the high-resolution digital twins necessary for infrastructure planning, zoning analysis, and smart city deployments.',
    image: '/images/our solutions/LidarEngineering/sectionimage/highDensityTopography.jpg'
  },
  {
    id: 'asset',
    tabLabel: 'Asset Mapping',
    tagline: 'Digitization of land records & large-area mapping.',
    heading: 'Geospatial Asset Records',
    description: 'Transform outdated physical land records into accurate, georeferenced digital formats. Our large-area asset mapping ensures you have clear, undeniable spatial data for boundary disputes, property management, and taxation.',
    image: '/images/our solutions/LidarEngineering/sectionimage/landRecords.jpg'
  }
];

const outputData = [
  {
    id: 'dtm',
    tabLabel: 'DTM',
    tagline: 'Digital Terrain Models mapping bare-earth topography.',
    heading: 'Digital Terrain Modeling',
    description: 'We filter out above-ground features like vegetation, vehicles, and buildings to provide a continuous surface of the bare earth. This pure topographic baseline is critical for hydrological modeling, road design, and foundational engineering.',
    image: '/images/our solutions/LidarEngineering/sectionimage/dtm.webp'
  },
  {
    id: 'dsm',
    tabLabel: 'DSM',
    tagline: 'Surface models including buildings and canopies.',
    heading: 'Digital Surface Modeling',
    description: 'A comprehensive 3D elevation model that includes everything on the earth’s surface. DSMs are essential for telecommunications line-of-sight analysis, urban planning, and vegetation encroachment monitoring.',
    image: '/images/our solutions/LidarEngineering/sectionimage/dsm.webp'
  },
  {
    id: 'contour',
    tabLabel: 'Contour',
    tagline: 'Precise topographic contour line mapping.',
    heading: 'Topographic Contours',
    description: 'We translate complex 3D point cloud data into clean, standard contour lines formatted specifically for immediate integration into your CAD or GIS software. Easily visualize elevation changes and slope gradients.',
    image: '/images/our solutions/LidarEngineering/sectionimage/contour.png'
  },
  {
    id: 'ortho',
    tabLabel: 'Orthomosaic',
    tagline: 'Distortion-free stitched 2D aerial maps.',
    heading: 'High-Res Orthomosaics',
    description: 'Thousands of individual drone photos seamlessly stitched together and geometrically corrected to scale. Measurements taken from these 2D maps are as accurate as those taken on the ground.',
    image: '/images/our solutions/LidarEngineering/sectionimage/ortho.webp'
  }
];
---

<Layout title="Geospatial Mapping & LiDAR | Rishika Infra">
  <Navbar />

  <!-- =========================================================
       HERO SECTION (Now Full-Screen Video)
       ========================================================= -->
  <section class="relative min-h-screen flex items-center pt-20 overflow-hidden bg-[#1D2630]">
    {/* Video Background */}
    <img fetchpriority="high"
      src="/images/our solutions/LidarEngineering/sectionimage/lidarPhoto.webp"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 h-full w-full object-cover pointer-events-none contrast-125"
    />

    <div class="absolute inset-0 bg-gradient-to-r from-[#17212B] via-[#17212B]/90 to-transparent"></div>
    
    <div class="relative z-10 mx-auto max-w-[1440px] px-6 lg:px-16 w-full">
      <div class="max-w-[800px] repeat-animate" data-transform="translateY(30px)">
        <p class="text-[12px] font-bold uppercase tracking-[0.3em] text-[#FFC62F] mb-6">
          Surveying & Mapping
        </p>
        <h1 class="text-[42px] font-extrabold leading-[1.05] tracking-tight text-white md:text-[56px] mb-6">
          Geospatial mapping and <br/>
          <span class="text-[#FFC62F]">3D modeling of areas</span>
        </h1>
        <p class="text-[17px] leading-relaxed text-white/90 mb-8 max-w-[650px]">
          End-to-end 3D mapping and modeling of large areas using UAVs, aerial platforms, LiDAR, and photogrammetry. We integrate cutting-edge RTK/PPK & GCP-based georeferencing for absolute accuracy.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/contact" class="inline-flex rounded-full bg-[#FFC62F] px-8 py-3.5 font-bold text-[#17212B] transition-all hover:bg-[#FFD85C] hover:-translate-y-1">
            Get in touch
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       VALUE PROP (Staggered Animation Logic Applied)
       ========================================================= -->
  <section class="bg-white py-32 overflow-hidden border-b border-gray-100">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-16 grid lg:grid-cols-2 gap-16 lg:gap-24 items-center">
      
      {/* TEXT CONTENT (Left - Staggered Waterfall Animation) */}
      <div class="flex flex-col items-start justify-center">
        <h2 
          class="text-4xl md:text-5xl font-extrabold text-[#17212B] mb-8 leading-tight repeat-animate transition-all duration-700 delay-100" 
          data-transform="translateX(-40px)"
        >
          Capture reality with <br/>
          <span class="text-[#0070BA]">unmatched speed</span>
        </h2>
        
        <p 
          class="text-[17px] text-gray-600 leading-relaxed mb-6 repeat-animate transition-all duration-700 delay-200" 
          data-transform="translateX(-40px)"
        >
          Drones equipped with high-resolution cameras and LiDAR sensors can quickly scan large areas. They generate accurate 2D maps and 3D terrain models of highway corridors.
        </p>
        
        <p 
          class="text-[17px] text-gray-600 leading-relaxed mb-10 repeat-animate transition-all duration-700 delay-300" 
          data-transform="translateX(-40px)"
        >
          This replaces long, costly, and hazardous manual surveys. Our rapid data acquisition using UAVs, fixed-wing aircraft, and airborne sensors is suitable for corridors, cities, mining leases, industrial zones, and infrastructure projects.
        </p>
        
        <ul class="space-y-4 font-bold text-[#17212B]">
          <li 
            class="flex items-center gap-3 repeat-animate transition-all duration-700 delay-400" 
            data-transform="translateX(-40px)"
          >
            <span class="flex items-center justify-center min-w-[24px] h-6 rounded-full bg-[#FFC62F]/20 text-[#FFC62F]">✓</span> 
            Integration of LiDAR and Photogrammetry for high accuracy and completeness
          </li>
          <li 
            class="flex items-center gap-3 repeat-animate transition-all duration-700 delay-500" 
            data-transform="translateX(-40px)"
          >
            <span class="flex items-center justify-center min-w-[24px] h-6 rounded-full bg-[#FFC62F]/20 text-[#FFC62F]">✓</span> 
            RTK/PPK & GCP-based georeferencing
          </li>
        </ul>
      </div>

      {/* CUSTOM GEOMETRIC IMAGE GRAPHIC (Right - Staggered Animations) */}
      <div class="relative h-[550px] w-full flex justify-center items-center">
        
        {/* Dashed Background Circle */}
        <div 
          class="absolute right-[10%] top-1/2 -translate-y-1/2 w-[400px] h-[400px] rounded-full border-2 border-dashed border-gray-400 z-0 repeat-animate transition-all duration-1000 delay-100" 
          data-transform="translateY(40px)"
        ></div>

        {/* Floating Accents */}
        <div 
          class="absolute top-8 left-[15%] w-12 h-20 bg-[#0070BA] -skew-x-[20deg] z-30 shadow-md repeat-animate transition-all duration-700 delay-500" 
          data-transform="translateY(-30px)"
        ></div>
        
        <div 
          class="absolute bottom-12 right-[15%] w-16 h-12 bg-[#FFC62F] -skew-x-[20deg] z-30 shadow-lg repeat-animate transition-all duration-700 delay-600" 
          data-transform="translateY(30px)"
        ></div>

        {/* Image 2 (Back Right - Software LiDAR) */}
        <div 
          class="absolute right-[5%] top-10 w-[300px] h-[320px] -skew-x-[20deg] overflow-hidden shadow-xl z-10 border-4 border-white bg-gray-900 group repeat-animate transition-all duration-1000 delay-200" 
          data-transform="translateX(50px)"
        >
          <div class="w-[150%] h-full skew-x-[20deg] -ml-[25%] transition-transform duration-[1.5s] ease-out group-hover:scale-110">
            <img loading="lazy" decoding="async" 
              src="/images/our solutions/LidarEngineering/sectionimage/softwarelidar.jpg" 
              alt="Digital Terrain Model" 
              class="w-full h-full object-cover opacity-80"
            />
          </div>
        </div>

        {/* Image 1 (Front Left - UAV Mapping) */}
        <div 
          class="absolute left-[5%] bottom-10 w-[320px] h-[380px] -skew-x-[20deg] overflow-hidden shadow-[20px_0_40px_-15px_rgba(0,0,0,0.4)] z-20 border-[8px] border-white bg-gray-100 group repeat-animate transition-all duration-1000 delay-300" 
          data-transform="translateY(60px)"
        >
          <div class="w-[150%] h-full skew-x-[20deg] -ml-[25%] transition-transform duration-[1.5s] ease-out group-hover:scale-105">
            <img loading="lazy" decoding="async" 
              src="/images/our solutions/LidarEngineering/sectionimage/lidarPhoto.webp" 
              alt="UAV Mapping" 
              class="w-full h-full object-cover"
            />
          </div>
        </div>
        
      </div>
    </div>
  </section>

  <!-- =========================================================
       INTERACTIVE COMPONENTS INJECTED HERE
       ========================================================= -->
       
  <AnimatedShowcase 
    subtitle="Industries Served" 
    title="Key Applications" 
    data={applicationsData} 
  />

  <AnimatedShowcase 
    subtitle="Deliverables" 
    title="Output Data" 
    data={outputData} 
  />

  <!-- =========================================================
       SHARED SECTIONS
       ========================================================= -->
  <Differentiators />

</Layout>