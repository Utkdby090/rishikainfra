---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/islands/Navbar';
import Differentiators from '../../components/shared/Differentiators.astro';
import AnimatedShowcase from '../../components/islands/AnimatedShowcase';

// DATA ARRAY FOR THE INTERACTIVE SHOWCASE (Updated with screenshot data)
const roadServicesData = [
  {
    id: 'planning',
    tabLabel: 'Survey & Planning',
    tagline: 'Foundational data for infrastructure design.',
    heading: 'Pre-Construction & DPR Surveys',
    description: 'We provide the highly accurate data needed before breaking ground. Our services include Drone-Based Topographic Surveys, Road Corridor & Alignment Surveys, and Mobile LiDAR mapping to ensure you have the exact data required for DPR (Detailed Project Report) Survey & Mapping Support.',
    image: 'https://images.unsplash.com/photo-1503387762-592deb58ef4e?q=80&w=1000&auto=format&fit=crop'
  },
  {
    id: 'construction',
    tabLabel: 'Construction',
    tagline: 'Track progress and material movement.',
    heading: 'Progress & Volumetric Tracking',
    description: 'Keep your mega-projects on schedule with comprehensive Construction Progress Monitoring. We deliver precise Earthwork & Stockpile Volume Calculations, alongside Before & After Construction Surveys and complete Drone Video & Project Documentation.',
    image: 'https://images.unsplash.com/photo-1579965342575-16428a7c8881?q=80&w=1000&auto=format&fit=crop'
  },
  {
    id: 'mapping',
    tabLabel: 'Asset Mapping',
    tagline: 'Digitize your infrastructure footprint.',
    heading: 'GIS & Right-of-Way Mapping',
    description: 'Secure and digitize your infrastructure with Right-of-Way (ROW) & Encroachment Mapping. We generate Orthomosaics, DSM, DTM & 3D Mapping to build a comprehensive Digital Road Inventory and a fully integrated GIS-Based Road Asset Database.',
    image: 'https://images.unsplash.com/photo-1584501257451-90a61a668e1c?q=80&w=1000&auto=format&fit=crop'
  },
  {
    id: 'inspection',
    tabLabel: 'Inspection',
    tagline: 'Ensure structural safety and compliance.',
    heading: 'Structural & Pavement Audits',
    description: 'Ensure long-term safety and compliance with high-resolution Road Condition & Pavement Inspections. Our advanced drone platforms safely access hard-to-reach areas for thorough Bridge & Culvert Inspections without requiring lane closures or disrupting traffic flow.',
    image: 'https://images.unsplash.com/photo-1508450859948-4e04fabaa4ea?q=80&w=1000&auto=format&fit=crop'
  }
];
---

<Layout title="Infrastructure & Roads | Rishika Infra">
  <Navbar client:load />

  <!-- =========================================================
       HERO SECTION
       ========================================================= -->
  <section class="relative min-h-[70vh] flex items-center pt-20 overflow-hidden bg-[#1D2630]">
    {/* Background Image: Construction/Highway */}
    <img 
      src="https://images.unsplash.com/photo-1545558014-8692077e9b5c?q=80&w=2500&auto=format&fit=crop" 
      class="absolute inset-0 h-full w-full object-cover opacity-40 scale-105" 
      alt="Infrastructure Construction" 
    />
    <div class="absolute inset-0 bg-gradient-to-r from-[#17212B] via-[#17212B]/90 to-transparent"></div>
    
    <div class="relative z-10 mx-auto max-w-[1440px] px-6 lg:px-16 w-full">
      <div class="max-w-[800px] repeat-animate" data-transform="translateY(30px)">
        <p class="text-[12px] font-bold uppercase tracking-[0.3em] text-[#FFC62F] mb-6">
          Our Services in Road Projects
        </p>
        <h1 class="text-[42px] font-extrabold leading-[1.05] tracking-tight text-white md:text-[56px] mb-6">
          End-to-End intelligence for <br/>
          <span class="text-[#FFC62F]">Road & Highway Projects</span>
        </h1>
        <p class="text-[17px] leading-relaxed text-white/90 mb-8 max-w-[650px]">
          From initial topographic and corridor alignment surveys to final GIS-based digital road inventories, Rishika Infra provides the comprehensive aerial data needed to design, construct, and maintain modern road networks.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/contact" class="inline-flex rounded-full bg-[#FFC62F] px-8 py-3.5 font-bold text-[#17212B] transition-all hover:bg-[#FFD85C] hover:-translate-y-1">
            Discuss Your Project
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       VALUE PROP (Custom Overlapping Slanted Images)
       ========================================================= -->
  <section class="bg-white py-32 overflow-hidden border-b border-gray-100">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-16 grid lg:grid-cols-2 gap-16 lg:gap-24 items-center">
      
      {/* TEXT CONTENT (Left) */}
      <div class="repeat-animate" data-transform="translateX(-40px)">
        <h2 class="text-4xl md:text-5xl font-extrabold text-[#17212B] mb-8 leading-tight">
          Complete visibility for <br/>
          <span class="text-[#0070BA]">transportation infrastructure</span>
        </h2>
        <p class="text-[17px] text-gray-600 leading-relaxed mb-6">
          Managing large-scale road projects requires highly accurate, up-to-date spatial information. Traditional ground surveys are often too slow, delaying Detailed Project Reports (DPR) and missing critical site variations.
        </p>
        <p class="text-[17px] text-gray-600 leading-relaxed mb-10">
          Our UAV and Mobile LiDAR deployments provide rapid, end-to-end data acquisition. We deliver everything from precise earthwork volume calculations to structural bridge inspections and complete digital road inventories, keeping your projects on track and on budget.
        </p>
        
        <ul class="space-y-4 font-bold text-[#17212B]">
          <li class="flex items-center gap-3">
            <span class="flex items-center justify-center w-6 h-6 rounded-full bg-[#FFC62F]/20 text-[#FFC62F]">✓</span> 
            Right-of-Way (ROW) & Encroachment Mapping
          </li>
          <li class="flex items-center gap-3">
            <span class="flex items-center justify-center w-6 h-6 rounded-full bg-[#FFC62F]/20 text-[#FFC62F]">✓</span> 
            Drone-Based Topographic & Alignment Surveys
          </li>
        </ul>
      </div>

      {/* CUSTOM GEOMETRIC IMAGE GRAPHIC (Right) */}
      <div class="relative h-[550px] w-full flex justify-center items-center repeat-animate" data-transform="translateX(40px)">
        <div class="absolute right-[10%] top-1/2 -translate-y-1/2 w-[400px] h-[400px] rounded-full border-2 border-dashed border-gray-400 z-0"></div>
        <div class="absolute top-8 left-[15%] w-12 h-20 bg-[#0070BA] -skew-x-[20deg] z-30"></div>
        <div class="absolute bottom-12 right-[15%] w-16 h-12 bg-[#FFC62F] -skew-x-[20deg] z-30 shadow-lg"></div>

        {/* Image 2 (Back Right - Highway construction) */}
        <div class="absolute right-[5%] top-10 w-[300px] h-[320px] -skew-x-[20deg] overflow-hidden shadow-xl z-10 border-4 border-white bg-gray-900">
          <div class="w-[150%] h-full skew-x-[20deg] -ml-[25%]">
            <img 
              src="https://images.unsplash.com/photo-1513828742140-ccaa28f3eda0?q=80&w=800&auto=format&fit=crop" 
              alt="Highway Construction" 
              class="w-full h-full object-cover opacity-90"
            />
          </div>
        </div>

        {/* Image 1 (Front Left - Construction site/Crane) */}
        <div class="absolute left-[5%] bottom-10 w-[320px] h-[380px] -skew-x-[20deg] overflow-hidden shadow-[20px_0_40px_-15px_rgba(0,0,0,0.4)] z-20 border-[8px] border-white bg-gray-100">
          <div class="w-[150%] h-full skew-x-[20deg] -ml-[25%]">
            <img 
              src="https://images.unsplash.com/photo-1541888086425-d81bb19240f5?q=80&w=800&auto=format&fit=crop" 
              alt="Construction Site Overview" 
              class="w-full h-full object-cover"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       INTERACTIVE COMPONENTS INJECTED HERE
       ========================================================= -->
       
  <AnimatedShowcase 
    client:visible 
    subtitle="Project Lifecycle" 
    title="Core Deliverables" 
    data={roadServicesData} 
  />

  <!-- =========================================================
       SHARED SECTIONS
       ========================================================= -->
  <Differentiators />

</Layout>