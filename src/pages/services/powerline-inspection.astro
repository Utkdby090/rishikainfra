---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/islands/Navbar';
import SolutionsGrid from '../../components/shared/SolutionsGrid.astro';
import Differentiators from '../../components/shared/Differentiators.astro';
import NewsSlider from '../../components/islands/NewsSlider';
import InteractiveInspectionTabs from '../../components/islands/InteractiveInspectionTabs';
---

<Layout title="Powerline Inspection | Rishika Infra">
  <Navbar client:load />

  <!-- =========================================================
       HERO (Video Background)
       ========================================================= -->
  <section class="relative min-h-screen flex items-center pt-20 overflow-hidden bg-[#17212B]">
    <video 
      class="absolute inset-0 h-full w-full object-cover opacity-60 pointer-events-none" 
      autoplay 
      muted 
      loop 
      playsinline 
      webkit-playsinline
      aria-hidden="true"
      poster="/images/powerline-hero-poster.jpg"
    >
      <source src="/videos/powerlineinspection/powerinspection.mp4" type="video/mp4" />
    </video>
    
    <div class="absolute inset-0 bg-gradient-to-r from-[#17212B] via-[#17212B]/80 to-transparent"></div>

    <div class="relative z-10 mx-auto max-w-[1440px] px-6 lg:px-16 w-full">
      <div class="max-w-[760px] repeat-animate" data-transform="translateY(30px)">
        <h1 class="text-[42px] font-extrabold leading-[1.05] tracking-tight text-white md:text-[56px]">
          Powerline inspections that go<br/>
          <span class="text-[#FFC62F]">beyond the drone</span>
        </h1>
        <p class="mt-6 max-w-[600px] text-[17px] leading-relaxed text-white/90">
          Effective aerial asset inspections go far beyond flying a drone. Our teams use advanced thermal sensors and GIS mapping to identify defects, evaluate severity, and inform repair prioritization across EHV, HV, and MV networks.
        </p>
        <div class="mt-8">
          <a href="/contact" class="inline-flex rounded-full bg-[#FFC62F] px-8 py-3.5 font-bold text-[#17212B] transition-all hover:bg-[#FFD85C] hover:-translate-y-1 focus:ring-2 focus:ring-[#FFC62F] focus:ring-offset-2 focus:ring-offset-[#17212B]">
            Get in touch
          </a>
        </div>
      </div>
    </div>
  </section>
  <!-- =========================================================
       SEE YOUR ASSETS (Custom Slanted Image Mask)
       ========================================================= -->
  <section class="bg-white py-32 overflow-hidden">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-16 grid lg:grid-cols-2 gap-16 lg:gap-24 items-center">

      <!-- TEXT CONTENT (Left) -->
      <div class="repeat-animate" data-transform="translateX(-40px)">
        <h2 class="text-4xl md:text-5xl font-extrabold text-[#17212B] mb-8 leading-tight">
          See your assets <br/>
          <span class="text-[#FFC62F]">like never before</span>
        </h2>
        <p class="text-[17px] text-gray-600 leading-relaxed mb-6">
          Aerial inspections deliver greater coverage and higher quality imagery, with fewer boots on the ground than traditional methods. This provides deeper insights into asset health, allowing for more accurate, data-driven decision-making, in a fraction of the time.
        </p>
        <p class="text-[17px] text-gray-600 leading-relaxed mb-10">
          By using drones instead of people to inspect hazardous or inaccessible areas, we can reduce the need for scaffolding or rope-access, keeping team members safely out of harm's way. This all adds up to faster, safer and more informative inspections, resulting in fewer truck rolls, reduced asset down time, better repair prioritization, ultimately keeping costs down.
        </p>
        <a href="/contact" class="inline-flex rounded-full bg-[#FFC62F] px-8 py-3 font-bold text-[#17212B] transition-all hover:bg-[#FFD85C] hover:-translate-y-1">
          Get in touch
        </a>
      </div>

      <!-- CUSTOM GEOMETRIC IMAGE GRAPHIC (Right) -->
      <div class="relative h-[500px] w-full flex justify-center items-center repeat-animate" data-transform="translateX(40px)">
        <div class="absolute right-0 top-1/2 -translate-y-1/2 w-[400px] h-[400px] rounded-full border-2 border-dashed border-gray-400 z-0"></div>
        <div class="absolute right-12 top-1/2 -translate-y-1/2 w-[300px] h-[300px] rounded-full border border-dashed border-[#FFC62F] z-0 opacity-50"></div>
        <div class="absolute top-10 left-10 w-16 h-24 bg-[#FFC62F] -skew-x-[20deg] z-10"></div>
        <div class="absolute bottom-10 right-20 w-12 h-16 bg-[#FFC62F] -skew-x-[20deg] z-10"></div>
        <div class="absolute top-1/2 right-0 w-10 h-16 bg-[#17212B] -skew-x-[20deg] z-10"></div>

        <div class="relative w-[350px] h-[450px] -skew-x-[20deg] overflow-hidden shadow-2xl z-20 border-8 border-white bg-gray-100">
          <div class="w-[150%] h-full skew-x-[20deg] -ml-[25%]">
            <img 
              src="https://images.unsplash.com/photo-1548345680-f5475ea90f14?q=80&w=800&auto=format&fit=crop" 
              alt="Drone Inspection" 
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        </div>

        <!-- Play Button intersecting the image -->
        <button aria-label="Play promotional video" class="absolute top-1/2 left-1/2 -translate-x-[70%] -translate-y-1/2 w-20 h-20 bg-white rounded-full shadow-xl z-30 flex items-center justify-center hover:scale-110 transition-transform cursor-pointer">
          <div class="w-0 h-0 border-t-[10px] border-t-transparent border-l-[16px] border-l-[#FFC62F] border-b-[10px] border-b-transparent ml-2"></div>
        </button>
      </div>
    </div>
  </section>

  <!-- =========================================================
       INTERACTIVE INSPECTION VIEWER
       ========================================================= -->
  <InteractiveInspectionTabs client:visible />

  <!-- =========================================================
       EXPERT EYES
       ========================================================= -->
  <section class="bg-[#17212B] py-32 overflow-hidden border-t border-white/10">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-16 grid lg:grid-cols-2 gap-16 lg:gap-24 items-center">

      <!-- CUSTOM COMPOSITE GRAPHIC (Left - Staggered Animations) -->
      <div class="relative h-[550px] w-full flex justify-center items-center">
        
        <!-- Dashed Circle -->
        <div 
          class="absolute right-[5%] top-1/2 -translate-y-1/2 w-[350px] h-[350px] rounded-full border-2 border-dashed border-[#FFC62F] opacity-40 z-0 repeat-animate transition-all duration-1000 delay-100" 
          data-transform="translateY(40px)"
        ></div>
        
        <!-- Top Yellow Accent -->
        <div 
          class="absolute top-4 left-[15%] w-16 h-24 bg-[#FFC62F] -skew-x-[20deg] z-30 shadow-lg repeat-animate transition-all duration-700 delay-500" 
          data-transform="translateY(-30px)"
        ></div>

        <!-- Back Image (Computer) -->
        <div 
          class="absolute right-[5%] top-12 w-[300px] h-[320px] -skew-x-[20deg] overflow-hidden shadow-2xl z-10 opacity-90 border-4 border-[#17212B] group repeat-animate transition-all duration-1000 delay-200" 
          data-transform="translateX(50px)"
        >
          <div class="w-[150%] h-full skew-x-[20deg] -ml-[25%] bg-gray-800 transition-transform duration-[1.5s] ease-out group-hover:scale-110">
            <img 
              src="/images/our solutions/powerGridInspection/sectionimages/computer.jpg" 
              alt="Engineers processing drone data" 
              class="w-full h-full object-cover opacity-80"
              loading="lazy"
            />
          </div>
        </div>

        <!-- Front Image (Grid) -->
        <div 
          class="absolute left-[5%] bottom-12 w-[320px] h-[380px] -skew-x-[20deg] overflow-hidden shadow-[30px_0_50px_-15px_rgba(0,0,0,0.7)] z-20 border-[10px] border-white group repeat-animate transition-all duration-1000 delay-300" 
          data-transform="translateY(60px)"
        >
          <div class="w-[150%] h-full skew-x-[20deg] -ml-[25%] transition-transform duration-[1.5s] ease-out group-hover:scale-105">
            <img 
              src="/images/our solutions/powerGridInspection/sectionimages/electricalgrid upclose.jpg" 
              alt="High Voltage Electrical Grid" 
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        </div>

        <!-- Bottom Yellow Accent -->
        <div 
          class="absolute bottom-8 right-[20%] w-12 h-16 bg-[#FFC62F] -skew-x-[20deg] z-30 shadow-lg repeat-animate transition-all duration-700 delay-700" 
          data-transform="translateY(30px)"
        ></div>
      </div>

      <!-- TEXT CONTENT (Right - Staggered Waterfall Animation) -->
      <div class="order-1 lg:order-2 flex flex-col items-start justify-center">
        
        <p 
          class="text-sm font-bold uppercase tracking-[0.25em] text-[#FFC62F] mb-4 repeat-animate transition-all duration-700 delay-100" 
          data-transform="translateX(40px)"
        >
          ENGINEERING INSPECTIONS
        </p>
        
        <h2 
          class="text-4xl md:text-5xl font-extrabold text-white mb-8 leading-tight repeat-animate transition-all duration-700 delay-200" 
          data-transform="translateX(40px)"
        >
          Get expert eyes <br/>on your grid
        </h2>
        
        <p 
          class="text-[17px] text-white/70 leading-relaxed mb-6 repeat-animate transition-all duration-700 delay-300" 
          data-transform="translateX(40px)"
        >
          A photo can't always tell you if a crack needs monitoring or an urgent shutdown. Our certified engineers know where to look to separate minor wear from major risk.
        </p>
        
        <p 
          class="text-[17px] text-white/70 leading-relaxed mb-8 repeat-animate transition-all duration-700 delay-400" 
          data-transform="translateX(40px)"
        >
          They process raw inspection data into actionable intelligence, sizing and classifying every defect against industry standards to give you clear, evidence-based insight.
        </p>
        
        <div 
          class="repeat-animate transition-all duration-700 delay-500" 
          data-transform="translateX(40px)"
        >
          <a 
            href="/contact" 
            class="inline-flex rounded-full border-2 border-white px-8 py-3 font-bold text-white transition-all hover:bg-white hover:text-[#17212B] hover:shadow-[0_0_20px_rgba(255,255,255,0.2)] hover:-translate-y-1"
          >
            Learn about our process
          </a>
        </div>
        
      </div>

    </div>
  </section>

  <!-- =========================================================
       SHARED SECTIONS
       ========================================================= -->
  <Differentiators />
  <NewsSlider client:visible />

</Layout>