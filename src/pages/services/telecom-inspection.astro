---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/islands/Navbar';
import Differentiators from '../../components/shared/Differentiators.astro';
import AnimatedShowcase from '../../components/islands/AnimatedShowcase';

// DATA ARRAY FOR THE INTERACTIVE SHOWCASE
const telecomData = [
  {
    id: 'structural',
    tabLabel: 'Structural Assessment',
    tagline: 'High-resolution auditing of overall tower health.',
    heading: 'Tower Structural Assessment',
    description: 'Capture millimeter-accurate visual data of the entire tower structure without putting personnel at risk. Our drones identify structural stress, missing hardware, and physical degradation on monopoles, lattice towers, and guyed masts to ensure absolute structural integrity.',
    image: '/images/our solutions/telecomInspection/assessment.jpg'
  },
  {
    id: 'antenna',
    tabLabel: 'Antenna Inspections',
    tagline: 'Detailed audits of mounts and active equipment.',
    heading: 'Antenna Inspections',
    description: 'Verify exact as-built conditions and equipment health. We capture detailed close-ups of antenna arrays, remote radio units (RRUs), and mounts to determine azimuths, tilts, and physical condition, ensuring your network equipment operates at peak performance.',
    image: '/images/our solutions/telecomInspection/antennainspection.jpg'
  },
  {
    id: 'corrosion',
    tabLabel: 'Corrosion Monitoring',
    tagline: 'Early detection of rust and material degradation.',
    heading: 'Corrosion Monitoring',
    description: 'Identify and track rust progression before it compromises tower safety. High-definition aerial imagery allows engineers to pinpoint surface corrosion and protective coating failures on critical joints, flanges, and climbing pegs without requiring hazardous manual climbs.',
    image: '/images/our solutions/telecomInspection/telecomtower.jpg'
  },
  {
    id: 'maintenance',
    tabLabel: 'Maintenance Planning',
    tagline: 'Actionable data for proactive, cost-effective upkeep.',
    heading: 'Maintenance Planning Support',
    description: 'Transform raw inspection data into proactive maintenance schedules. By centralizing high-resolution imagery and defect classifications into clear reports, we empower engineering teams to prioritize repairs, allocate budgets efficiently, and extend the lifespan of telecom assets.',
    image: '/images/our solutions/telecomInspection/preventivemaintainence.jpg'
  }
];
---

<Layout title="Telecom Tower Inspection | Rishika Infra">
  <Navbar client:load />

  <!-- =========================================================
       HERO SECTION (Now Full-Screen Video)
       ========================================================= -->
  <section class="relative min-h-screen flex items-center pt-20 overflow-hidden bg-[#1D2630]">
    {/* Video Background */}
    <video 
      class="absolute inset-0 h-full w-full object-cover  pointer-events-none scale-105" 
      autoplay 
      muted 
      loop 
      playsinline 
      webkit-playsinline
      aria-hidden="true"
      poster="https://images.unsplash.com/photo-1620023772186-e7de19302604?q=80&w=2500&auto=format&fit=crop"
    >
      <source src="/videos/telecomTower/telecomtower.mp4" type="video/mp4" />
    </video>
    
    <div class="absolute inset-0 bg-gradient-to-r from-[#17212B] via-[#17212B]/90 to-transparent"></div>
    
    <div class="relative z-10 mx-auto max-w-[1440px] px-6 lg:px-16 w-full">
      <div class="max-w-[800px] repeat-animate" data-transform="translateY(30px)">
        <p class="text-[12px] font-bold uppercase tracking-[0.3em] text-[#FFC62F] mb-6">
          Telecom Tower Inspection
        </p>
        <h1 class="text-[42px] font-extrabold leading-[1.05] tracking-tight text-white md:text-[56px] mb-6">
          Precision data for <br/>
          <span class="text-[#FFC62F]">proactive maintenance</span>
        </h1>
        <p class="text-[17px] leading-relaxed text-white/90 mb-8 max-w-[650px]">
          Rishika Infra utilizes advanced drone platforms to capture comprehensive, high-resolution data of your telecommunications portfolio. We deliver thorough structural assessments, antenna inspections, and corrosion monitoring to fully support your maintenance planning.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/contact" class="inline-flex rounded-full bg-[#FFC62F] px-8 py-3.5 font-bold text-[#17212B] transition-all hover:bg-[#FFD85C] hover:-translate-y-1">
            Get in touch
          </a>
        </div>
      </div>
    </div>
  </section>

 <!-- =========================================================
       VALUE PROP (Staggered Animation Logic Applied)
       ========================================================= -->
  <section class="bg-white py-32 overflow-hidden border-b border-gray-100">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-16 grid lg:grid-cols-2 gap-16 lg:gap-24 items-center">
      
      {/* TEXT CONTENT (Left - Staggered Waterfall Animation) */}
      <div class="flex flex-col items-start justify-center">
        <h2 
          class="text-4xl md:text-5xl font-extrabold text-[#17212B] mb-8 leading-tight repeat-animate transition-all duration-700 delay-100" 
          data-transform="translateX(-40px)"
        >
          Climb less, <br/>
          <span class="text-[#0070BA]">assess more</span>
        </h2>
        
        <p 
          class="text-[17px] text-gray-600 leading-relaxed mb-6 repeat-animate transition-all duration-700 delay-200" 
          data-transform="translateX(-40px)"
        >
          Manual tower inspections are inherently dangerous and time-consuming. Our drone-based approach changes the paradigm, capturing high-resolution imagery in a fraction of the time to safely evaluate overall structural health and antenna conditions.
        </p>
        
        <p 
          class="text-[17px] text-gray-600 leading-relaxed mb-10 repeat-animate transition-all duration-700 delay-300" 
          data-transform="translateX(-40px)"
        >
          By rapidly identifying material degradation, missing hardware, and surface corrosion, we provide engineering teams with the exact visual evidence required to support effective, proactive maintenance planning while keeping personnel safely on the ground.
        </p>
        
        <ul class="space-y-4 font-bold text-[#17212B]">
          <li 
            class="flex items-center gap-3 repeat-animate transition-all duration-700 delay-400" 
            data-transform="translateX(-40px)"
          >
            <span class="flex items-center justify-center min-w-[24px] h-6 rounded-full bg-[#FFC62F]/20 text-[#FFC62F]">✓</span> 
            Identify structural stress and corrosion safely
          </li>
          <li 
            class="flex items-center gap-3 repeat-animate transition-all duration-700 delay-500" 
            data-transform="translateX(-40px)"
          >
            <span class="flex items-center justify-center min-w-[24px] h-6 rounded-full bg-[#FFC62F]/20 text-[#FFC62F]">✓</span> 
            Detailed antenna audits without network downtime
          </li>
        </ul>
      </div>

      {/* CUSTOM GEOMETRIC IMAGE GRAPHIC (Right - Staggered Animations) */}
      <div class="relative h-[550px] w-full flex justify-center items-center">
        
        {/* Dashed Background Circle */}
        <div 
          class="absolute right-[10%] top-1/2 -translate-y-1/2 w-[400px] h-[400px] rounded-full border-2 border-dashed border-gray-400 z-0 repeat-animate transition-all duration-1000 delay-100" 
          data-transform="translateY(40px)"
        ></div>

        {/* Floating Accents */}
        <div 
          class="absolute top-8 left-[15%] w-12 h-20 bg-[#0070BA] -skew-x-[20deg] z-30 shadow-md repeat-animate transition-all duration-700 delay-500" 
          data-transform="translateY(-30px)"
        ></div>
        
        <div 
          class="absolute bottom-12 right-[15%] w-16 h-12 bg-[#FFC62F] -skew-x-[20deg] z-30 shadow-lg repeat-animate transition-all duration-700 delay-600" 
          data-transform="translateY(30px)"
        ></div>

        {/* Image 2 (Back Right - Telecom Tower Close-up) */}
        <div 
          class="absolute right-[5%] top-10 w-[300px] h-[320px] -skew-x-[20deg] overflow-hidden shadow-xl z-10 border-4 border-white bg-gray-900 group repeat-animate transition-all duration-1000 delay-200" 
          data-transform="translateX(50px)"
        >
          <div class="w-[150%] h-full skew-x-[20deg] -ml-[25%] transition-transform duration-[1.5s] ease-out group-hover:scale-110">
            <img 
              src="https://images.unsplash.com/photo-1519003300449-424ad0405076?q=80&w=800&auto=format&fit=crop" 
              alt="Telecom Antenna Close-up" 
              class="w-full h-full object-cover opacity-90"
              loading="lazy"
            />
          </div>
        </div>

        {/* Image 1 (Front Left - Drone / Tech) */}
        <div 
          class="absolute left-[5%] bottom-10 w-[320px] h-[380px] -skew-x-[20deg] overflow-hidden shadow-[20px_0_40px_-15px_rgba(0,0,0,0.4)] z-20 border-[8px] border-white bg-gray-100 group repeat-animate transition-all duration-1000 delay-300" 
          data-transform="translateY(60px)"
        >
          <div class="w-[150%] h-full skew-x-[20deg] -ml-[25%] transition-transform duration-[1.5s] ease-out group-hover:scale-105">
            <img 
              src="https://images.unsplash.com/photo-1581092334246-88dd830171bd?q=80&w=800&auto=format&fit=crop" 
              alt="Industrial Drone Inspection" 
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        </div>
        
      </div>
    </div>
  </section>

  <!-- =========================================================
       INTERACTIVE COMPONENTS INJECTED HERE
       ========================================================= -->
       
  <AnimatedShowcase 
    client:visible 
    subtitle="Inspection Deliverables" 
    title="Actionable Insights" 
    data={telecomData} 
  />

  <!-- =========================================================
       SHARED SECTIONS
       ========================================================= -->
  <Differentiators />

</Layout>