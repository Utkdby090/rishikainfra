---
import Img from '../../components/shared/Img.astro';
import Layout from '../../layouts/Layout.astro';
import Differentiators from '../../components/shared/Differentiators.astro';
import AnimatedShowcase from '../../components/AnimatedShowcase.astro';
const trafficAnalyticsData = [
  {
    id: 'flow',
    tabLabel: 'Traffic Flow',
    tagline: 'Observe traffic flow during peak periods.',
    heading: 'Congestion & Flow Analysis',
    description: 'During peak periods or major events, our drones observe traffic flow from above. This aerial perspective helps authorities in studying congestion patterns and planning effective route diversions.',
    image: '/images/our solutions/trafficai/congestion-flow-analysis.jpg'
  },
  {
    id: 'kinematics',
    tabLabel: 'Speed & Acceleration',
    tagline: 'Extract precise vehicle kinematics.',
    heading: 'Speed & Acceleration Tracking',
    description: 'Utilize AI-based drones to get quick results on vehicle behavior. Our analytics extract highly accurate speed and acceleration data directly from the aerial video feed to monitor roadway compliance.',
    image: '/images/our solutions/trafficai/speed-acceleration-tracking.jpg'
  },
  {
    id: 'gap-time',
    tabLabel: 'Gap Time & PET',
    tagline: 'Measure intersection efficiency metrics.',
    heading: 'Gap Time & PET',
    description: 'Evaluate intersection safety and traffic light efficiency by extracting advanced metrics like gap time and Post Encroachment Time (PET) from complex junctions and merging lanes.',
    image: '/images/our solutions/trafficai/gap-time-pet.jpg'
  },
  {
    id: 'safety',
    tabLabel: 'Safety Analysis',
    tagline: 'Calculate collision risks instantly.',
    heading: 'Time to Collision & Safety',
    description: 'Gain comprehensive safety analysis data. Our AI models process the drone footage to calculate Time to Collision metrics, helping planners identify dangerous bottlenecks and improve overall road safety.',
    image: '/images/our solutions/trafficai/collision-safety.jpg'
  }
];
---

<Layout
  title="Traffic Monitoring & Safety | Rishika Infra"
  description="AI-powered drone traffic surveys that capture peak-hour and event traffic flow so highway authorities can study congestion and plan diversions."
  breadcrumbs={[{ name: 'Traffic Management with AI', path: '/services/traffic-ai' }]}
  schema={[
    {
      '@type': 'Service',
      name: 'Traffic Management with AI',
      serviceType: 'Traffic Management with AI',
      description: 'AI-powered drone traffic surveys that capture peak-hour and event traffic flow so highway authorities can study congestion and plan diversions.',
      provider: { '@id': 'https://rishikainfra.com/#organization' },
      areaServed: 'IN',
    },
  ]}
>

  <!-- =========================================================
       HERO SECTION (Now Full-Screen Video)
       ========================================================= -->
  <section class="relative min-h-screen flex items-center pt-20 overflow-hidden bg-brand-slate">
    {/* Video Background */}
    <Img fetchpriority="high"
      src="/images/cards/highway.jpg"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 h-full w-full object-cover opacity-30 pointer-events-none scale-105"
    />

    <div class="absolute inset-0 bg-gradient-to-r from-brand-ink via-brand-ink/90 to-transparent"></div>
    
    <div class="relative z-10 mx-auto max-w-[1440px] px-6 lg:px-16 w-full">
      <div class="max-w-[800px] repeat-animate" data-transform="translateY(30px)">
        <p class="text-[12px] font-bold uppercase tracking-[0.3em] text-brand-yellow mb-6">
          Smart Analytics
        </p>
        <h1 class="text-[42px] font-extrabold leading-[1.05] tracking-tight text-white md:text-[56px] mb-6">
          Traffic Monitoring <br/>
          <span class="text-brand-yellow">& Safety</span>
        </h1>
        <p class="text-[17px] leading-relaxed text-white/90 mb-8 max-w-[650px]">
          AI-based drones can give quick results. We capture high-altitude aerial data during peak periods and major events to observe traffic flow, enabling highway authorities to study congestion patterns and plan diversions effectively.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/contact" class="inline-flex rounded-full bg-brand-yellow px-8 py-3.5 font-bold text-brand-ink transition-all hover:bg-brand-yellow-light hover:-translate-y-1">
            Get in touch
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       VALUE PROP (Staggered Animation Logic Applied)
       ========================================================= -->
  <section class="bg-white py-32 overflow-hidden border-b border-gray-100">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-16 grid lg:grid-cols-2 gap-16 lg:gap-24 items-center">
      
      {/* TEXT CONTENT (Left - Staggered Waterfall Animation) */}
      <div class="flex flex-col items-start justify-center">
        <h2 
          class="text-4xl md:text-5xl font-extrabold text-brand-ink mb-8 leading-tight repeat-animate transition-all duration-700 delay-100" 
          data-transform="translateX(-40px)"
        >
          Study patterns, <br/>
          <span class="text-brand-blue">plan diversions</span>
        </h2>
        
        <p 
          class="text-[17px] text-gray-600 leading-relaxed mb-6 repeat-animate transition-all duration-700 delay-200" 
          data-transform="translateX(-40px)"
        >
          During peak periods or major events, drones observe traffic flow to provide comprehensive situational awareness. This aerial perspective is critical for understanding how vehicles behave in real-world scenarios.
        </p>
        
        <p 
          class="text-[17px] text-gray-600 leading-relaxed mb-10 repeat-animate transition-all duration-700 delay-300" 
          data-transform="translateX(-40px)"
        >
          Our AI-based drones give quick, actionable results. We process the footage to help you study deep congestion patterns and plan safer, more efficient road diversions.
        </p>
        
        <ul class="space-y-4 font-bold text-brand-ink">
          <li 
            class="flex items-center gap-3 repeat-animate transition-all duration-700 delay-400" 
            data-transform="translateX(-40px)"
          >
            <span class="flex items-center justify-center min-w-[24px] h-6 rounded-full bg-brand-yellow/20 text-brand-yellow">✓</span> 
            Get speed, acceleration, and gap time data
          </li>
          <li 
            class="flex items-center gap-3 repeat-animate transition-all duration-700 delay-500" 
            data-transform="translateX(-40px)"
          >
            <span class="flex items-center justify-center min-w-[24px] h-6 rounded-full bg-brand-yellow/20 text-brand-yellow">✓</span> 
            Safety analysis including time to collision and PET
          </li>
        </ul>
      </div>

      {/* CUSTOM GEOMETRIC IMAGE GRAPHIC (Right - Staggered Animations) */}
      <div class="relative h-[550px] w-full flex justify-center items-center">
        
        {/* Dashed Background Circle */}
        <div 
          class="absolute right-[10%] top-1/2 -translate-y-1/2 w-[400px] h-[400px] rounded-full border-2 border-dashed border-gray-400 z-0 repeat-animate transition-all duration-1000 delay-100" 
          data-transform="translateY(40px)"
        ></div>

        {/* Floating Accents */}
        <div 
          class="absolute top-8 left-[15%] w-12 h-20 bg-brand-blue -skew-x-[20deg] z-30 shadow-md repeat-animate transition-all duration-700 delay-500" 
          data-transform="translateY(-30px)"
        ></div>
        
        <div 
          class="absolute bottom-12 right-[15%] w-16 h-12 bg-brand-yellow -skew-x-[20deg] z-30 shadow-lg repeat-animate transition-all duration-700 delay-600" 
          data-transform="translateY(30px)"
        ></div>

        {/* Image 2 (Back Right - Intersection from above) */}
        <div 
          class="absolute right-[5%] top-10 w-[300px] h-[320px] overflow-hidden shadow-xl z-10 border-4 border-white bg-gray-900 group repeat-animate transition-all duration-1000 delay-200" 
          data-transform="translateX(50px)"
        >
          <div class="w-full h-full transition-transform duration-[1.5s] ease-out group-hover:scale-110">
            <Img loading="lazy" decoding="async" 
              src="/images/our solutions/trafficai/traffic-analysis.jpg" sizes="480px" 
              alt="Aerial view of a busy road intersection at night" 
              class="w-full h-full object-cover opacity-90"
              loading="lazy"
            />
          </div>
        </div>

        {/* Image 1 (Front Left - Traffic camera pole) */}
        <div 
          class="absolute left-[5%] bottom-10 w-[320px] h-[380px] overflow-hidden shadow-[20px_0_40px_-15px_rgba(0,0,0,0.4)] z-20 border-[8px] border-white bg-gray-100 group repeat-animate transition-all duration-1000 delay-300" 
          data-transform="translateY(60px)"
        >
          <div class="w-full h-full transition-transform duration-[1.5s] ease-out group-hover:scale-105">
            <Img loading="lazy" decoding="async" 
              src="/images/our solutions/trafficai/traffic-monitor.jpg" sizes="480px" 
              alt="Traffic camera and sensors mounted on a roadside pole" 
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        </div>
        
      </div>
    </div>
  </section>

  <!-- =========================================================
       INTERACTIVE COMPONENTS INJECTED HERE
       ========================================================= -->
       
  <AnimatedShowcase 
    subtitle="AI Capabilities" 
    title="Traffic Data Extraction" 
    data={trafficAnalyticsData} 
  />

  <!-- =========================================================
       SHARED SECTIONS
       ========================================================= -->
  <Differentiators />

</Layout>