---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout hideCTA title="Thank You | Rishika Infra">
  <Navbar />

  <section class="min-h-screen flex items-center justify-center pt-20 overflow-hidden bg-[#1D2630] relative">
    <div class="absolute inset-0 bg-gradient-to-t from-[#17212B] to-transparent"></div>
    
    <div class="relative z-10 mx-auto max-w-2xl px-6 text-center repeat-animate" data-transform="translateY(30px)">
      
      {/* Animated Checkmark Icon */}
      <div class="w-20 h-20 bg-[#FFC62F]/10 rounded-full flex items-center justify-center mx-auto mb-8 border border-[#FFC62F]/20 shadow-[0_0_30px_rgba(255,198,47,0.15)]">
        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#FFC62F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
          <path d="m9 11 3 3L22 4"/>
        </svg>
      </div>
      
      <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-6">
        Message Received
      </h1>
      <p class="text-lg text-white/80 mb-10 leading-relaxed">
        Thank you for reaching out to Rishika Infra. Our engineering and surveying team has received your project details and will be in touch within 24 hours.
      </p>
      
      <a 
        href="/" 
        class="inline-flex items-center justify-center rounded-full bg-[#FFC62F] px-10 py-4 font-bold text-[#17212B] transition-all hover:bg-[#FFD85C] hover:-translate-y-1 shadow-lg hover:shadow-xl"
      >
        Return to Homepage
      </a>

    </div>
  </section>
</Layout>